import 'package:flutter/material.dart';

class LevelInfo {
  final String name;
  final String description;
  final Color color;
  final int start;
  final int end;

  LevelInfo({
    required this.name,
    required this.description,
    required this.color,
    required this.start,
    required this.end,
  });
}

class LevelUtils {
  static List<LevelInfo> getAllLevels(int readCount) {
    final levels = [
      LevelInfo(name: "🌱 새싹", description: "이제 막 책의 세계에 들어선 독서 새싹", color: Colors.lightGreen, start: 0, end: 4),
      LevelInfo(name: "📖 독서 초심자", description: "습관을 만들고 있는 독서 입문자", color: Colors.yellow.shade700, start: 5, end: 9),
      LevelInfo(name: "🔎 탐색자", description: "다양한 장르의 책을 시도하는 탐험가", color: Colors.orange.shade600, start: 10, end: 14),
      LevelInfo(name: "🌿 성장가", description: "독서로 인생의 방향을 찾아가는 독립 독서가", color: Colors.teal.shade300, start: 15, end: 19),
      LevelInfo(name: "🌊 유영가", description: "책 속에서 자유롭게 유영하는 자", color: Colors.blue.shade300, start: 20, end: 29),
      LevelInfo(name: "🔮 성찰가", description: "독서를 통해 내면을 성찰하는 자", color: Colors.indigo, start: 30, end: 39),
      LevelInfo(name: "🌠 통찰가", description: "책 속에서 진리를 발견하는 자", color: Colors.deepPurple, start: 40, end: 49),
      LevelInfo(name: "🧭 철학자", description: "자신만의 독서 철학을 갖춘 자", color: Colors.brown.shade400, start: 50, end: 59),
      LevelInfo(name: "🧙 현자", description: "지식과 지혜를 삶에 녹여내는 자", color: Colors.grey.shade600, start: 60, end: 69),
      LevelInfo(name: "🕊 선구자", description: "독서로 타인과 세상을 비추는 자", color: const Color(0xFF607D8B), start: 70, end: 79),
      LevelInfo(name: "🦉 마스터", description: "독서의 깊이와 넓이를 모두 아우르는 자", color: const Color(0xFFBDBDBD), start: 80, end: 89),
      LevelInfo(name: "🧬 창조자", description: "지식과 상상력으로 세상을 재창조하는 자", color: Colors.amber.shade800, start: 90, end: 99),
      LevelInfo(name: "🐉 전설", description: "전설적인 독서가, 그 이름만으로도 감동", color: const Color(0xFF212121), start: 100, end: 109),
    ];

    // 🔁 전설 이후의 레벨 (110부터 10권 단위로)
    if (readCount >= 110) {
      int extra = ((readCount - 110) / 10).ceil();
      for (int i = 1; i <= extra; i++) {
        int start = 110 + (i - 1) * 10;
        int end = start + 9;
        levels.add(LevelInfo(
          name: "🐉 전설 ${i + 1}단",
          description: "끝없는 독서 여정을 걷는 자",
          color: Colors.red.shade700,
          start: start,
          end: end,
        ));
      }
    }

    return levels;
  }

  static Widget buildShieldIcon(LevelInfo level) {
    if (level.name.contains("전설")) {
      return ShaderMask(
        shaderCallback: (bounds) {
          return const LinearGradient(
            colors: [Colors.black, Colors.red],
            begin: Alignment.topLeft,
            end: Alignment.bottomRight,
          ).createShader(bounds);
        },
        child: const Icon(Icons.shield, size: 36, color: Colors.white),
      );
    } else {
      return Icon(Icons.shield, color: level.color, size: 36);
    }
  }

  static LevelInfo getCurrentLevel(int readCount) {
    final allLevels = getAllLevels(readCount);

    for (final level in allLevels) {
      if (readCount >= level.start && readCount <= level.end) return level;
    }

    // fallback
    return LevelInfo(
      name: "알 수 없음",
      description: "레벨 정보를 찾을 수 없습니다",
      color: Colors.grey,
      start: 0,
      end: 0,
    );
  }
}
