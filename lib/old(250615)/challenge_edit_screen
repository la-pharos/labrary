import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import 'dart:io';
import 'package:image_picker/image_picker.dart';
import 'package:dayverse_book/model/challenge_model.dart';
import 'package:dayverse_book/old(250615)/challenge_provider.dart';
import 'package:dayverse_book/model/series_model.dart';

class ChallengeEditScreen extends StatefulWidget {
  final Challenge challenge;

  const ChallengeEditScreen({super.key, required this.challenge});

  @override
  State<ChallengeEditScreen> createState() => _ChallengeEditScreenState();
}

class _ChallengeEditScreenState extends State<ChallengeEditScreen> {
  late TextEditingController _titleController;
  late TextEditingController _descriptionController;
  late TextEditingController _goalController;
  DateTime? _startDate;
  DateTime? _endDate;

  File? _selectedImage;
  List<Map<String, dynamic>> _selectedBooks = [];
  List<Series> _seriesList = [];

  @override
  void initState() {
    super.initState();
    _titleController = TextEditingController(text: widget.challenge.title);
    _descriptionController = TextEditingController(text: widget.challenge.shortDescription);
    _goalController = TextEditingController(text: widget.challenge.totalBooks?.toString() ?? '');
    _startDate = widget.challenge.startDate;
    _endDate = widget.challenge.endDate;
    _selectedBooks = widget.challenge.requiredBooks ?? [];
    if (widget.challenge.imageUrl.startsWith('/')) {
      _selectedImage = File(widget.challenge.imageUrl);
    }
  }

  @override
  void dispose() {
    _titleController.dispose();
    _descriptionController.dispose();
    _goalController.dispose();
    super.dispose();
  }

  Future<void> _pickDate({required bool isStart}) async {
    final picked = await showDatePicker(
      context: context,
      initialDate: isStart ? (_startDate ?? DateTime.now()) : (_endDate ?? DateTime.now().add(const Duration(days: 7))),
      firstDate: DateTime(2000),
      lastDate: DateTime(2100),
    );
    if (picked != null) {
      setState(() {
        if (isStart) {
          _startDate = picked;
          if (_endDate != null && _endDate!.isBefore(_startDate!)) {
            _endDate = _startDate;
          }
        } else {
          _endDate = picked;
        }
      });
    }
  }

  Future<void> _pickImage() async {
    final picker = ImagePicker();
    final pickedFile = await picker.pickImage(source: ImageSource.gallery);
    if (pickedFile != null) {
      setState(() {
        _selectedImage = File(pickedFile.path);
      });
    }
  }

  void _submitEdit() {
    final title = _titleController.text.trim();
    final description = _descriptionController.text.trim();

    if (title.isEmpty || description.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text("제목과 설명은 필수입니다.")),
      );
      return;
    }

    int? totalBooks;
    if (widget.challenge.method == ChallengeMethod.quantityBased) {
      totalBooks = int.tryParse(_goalController.text.trim());
      if (totalBooks == null || totalBooks <= 0) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text("목표 권수를 올바르게 입력해주세요.")),
        );
        return;
      }
    }

    final updatedChallenge = widget.challenge.copyWith(
      title: title,
      shortDescription: description,
      startDate: _startDate,
      endDate: _endDate,
      totalBooks: totalBooks,
      requiredBooks: widget.challenge.method == ChallengeMethod.specificBooks ? _selectedBooks : null,
      imageUrl: _selectedImage?.path ?? widget.challenge.imageUrl,
    );

    Provider.of<ChallengeProvider>(context, listen: false).updateChallenge(updatedChallenge);

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(content: Text("챌린지가 수정되었습니다.")),
    );

    Navigator.pop(context);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF013328),
      appBar: AppBar(
        backgroundColor: Colors.transparent,
        title: const Text("챌린지 편집", style: TextStyle(color: Colors.white)),
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(20),
        child: Column(
          children: [
            _buildTextField(_titleController, "챌린지 이름"),
            const SizedBox(height: 12),
            _buildTextField(_descriptionController, "챌린지 설명", maxLines: 3),
            const SizedBox(height: 20),
            if (widget.challenge.period == ChallengePeriod.periodBased)
              _buildDateSelector(),
            const SizedBox(height: 20),
            if (widget.challenge.method == ChallengeMethod.quantityBased)
              _buildTextField(_goalController, "목표 권수 (숫자만)", isNumber: true),
            if (widget.challenge.method == ChallengeMethod.specificBooks)
              _buildSelectedBookList(),
            const SizedBox(height: 20),
            _buildImagePickerButton(),
            const SizedBox(height: 30),
            ElevatedButton(
              onPressed: _submitEdit,
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.amberAccent,
              ),
              child: const Text(
                "수정 완료",
                style: TextStyle(color: Colors.black, fontWeight: FontWeight.bold),
              ),
            )
          ],
        ),
      ),
    );
  }

  Widget _buildTextField(TextEditingController controller, String hint, {int maxLines = 1, bool isNumber = false}) {
    return TextField(
      controller: controller,
      keyboardType: isNumber ? TextInputType.number : TextInputType.text,
      maxLines: maxLines,
      style: const TextStyle(color: Colors.white),
      decoration: InputDecoration(
        hintText: hint,
        hintStyle: const TextStyle(color: Colors.white54),
        filled: true,
        fillColor: Colors.white10,
        border: OutlineInputBorder(borderRadius: BorderRadius.circular(8)),
      ),
    );
  }

  Widget _buildDateSelector() {
    return Row(
      children: [
        Expanded(
          child: TextButton(
            onPressed: () => _pickDate(isStart: true),
            child: Text("시작: ${_formatDate(_startDate ?? DateTime.now())}", style: const TextStyle(color: Colors.white)),
          ),
        ),
        const SizedBox(width: 10),
        Expanded(
          child: TextButton(
            onPressed: () => _pickDate(isStart: false),
            child: Text("종료: ${_formatDate(_endDate ?? DateTime.now().add(const Duration(days: 7)))}", style: const TextStyle(color: Colors.white)),
          ),
        ),
      ],
    );
  }

  Widget _buildSelectedBookList() {
    if (_selectedBooks.isEmpty) return const SizedBox.shrink();
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text("지정 도서 목록", style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
        const SizedBox(height: 10),
        ..._selectedBooks.map((book) {
          return Container(
            margin: const EdgeInsets.only(bottom: 8),
            padding: const EdgeInsets.all(8),
            decoration: BoxDecoration(
              color: Colors.white10,
              borderRadius: BorderRadius.circular(8),
            ),
            child: Text("${book['title']} (${book['author']})", style: const TextStyle(color: Colors.white)),
          );
        }).toList(),
      ],
    );
  }

  Widget _buildImagePickerButton() {
    return ElevatedButton(
      onPressed: _pickImage,
      style: ElevatedButton.styleFrom(backgroundColor: Colors.amberAccent),
      child: const Text("대표 이미지 변경", style: TextStyle(color: Colors.black)),
    );
  }

  String _formatDate(DateTime date) {
    return "${date.year}.${date.month.toString().padLeft(2, '0')}.${date.day.toString().padLeft(2, '0')}";
  }
}