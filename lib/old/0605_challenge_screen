import 'package:flutter/material.dart';
import 'package:dayverse_book/main.dart';
import 'package:dayverse_book/model/challenge_model.dart';
import 'package:dayverse_book/provider/challenge_provider.dart';
import 'package:dayverse_book/provider/saved_books_provider.dart';
import 'package:provider/provider.dart';
import 'challenge_detail_screen.dart';
import 'package:dayverse_book/screen/challenge_intro_screen.dart';
import 'package:dayverse_book/screen/challenge_ongoing_screen.dart';
import 'package:dayverse_book/screen/challenge_create_screen.dart';


class ChallengeCard extends StatelessWidget {
  final Challenge challenge;
  final VoidCallback? onTap;
  final bool showAttemptsBadge;

  const ChallengeCard({
    super.key,
    required this.challenge,
    this.onTap,
    this.showAttemptsBadge = false,
  });

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      child: Stack(
        children: [
          Container(
            margin: const EdgeInsets.only(bottom: 16),
            padding: const EdgeInsets.all(12),
            decoration: BoxDecoration(
              color: Colors.white10,
              borderRadius: BorderRadius.circular(12),
            ),
            child: Row(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                ClipRRect(
                  borderRadius: BorderRadius.circular(8),
                  child: Image.asset(
                    challenge.imageUrl,
                    width: 60,
                    height: 60,
                    fit: BoxFit.cover,
                    errorBuilder: (context, error, stackTrace) => Container(
                      width: 60,
                      height: 60,
                      color: Colors.grey,
                      child: const Icon(Icons.flag, color: Colors.white),
                    ),
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        challenge.title,
                        overflow: TextOverflow.ellipsis,
                        maxLines: 1,
                        style: const TextStyle(
                          color: Colors.white,
                          fontFamily: 'kopub',
                          fontSize: 18,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                      const SizedBox(height: 6),
                      Text(
                        challenge.shortDescription,
                        overflow: TextOverflow.ellipsis,
                        maxLines: 2,
                        style: const TextStyle(
                          fontFamily: 'kopub',
                          color: Colors.white70,
                          fontSize: 14,
                        ),
                      ),
                    ],
                  ),
                ),
                if (challenge.isPremium)
                  const Padding(
                    padding: EdgeInsets.only(left: 6),
                    child: Icon(Icons.lock, color: Colors.amberAccent, size: 20),
                  ),
              ],
            ),
          ),
          if (showAttemptsBadge && challenge.isRepeatable)
            Builder(
              builder: (context) {
                final completedCount = challenge.attempts
                    .where((a) => a.completed)
                    .length;

                if (completedCount > 0) {
                  return Positioned(
                    top: 4,
                    right: 4,
                    child: Container(
                      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                      decoration: BoxDecoration(
                        color: Colors.amberAccent,
                        borderRadius: BorderRadius.circular(12),
                      ),
                      child: Text(
                        "🏅 $completedCount회 달성",
                        style: const TextStyle(
                          color: Colors.black,
                          fontSize: 12,
                          fontWeight: FontWeight.bold,
                          fontFamily: 'kopub',
                        ),
                      ),
                    ),
                  );
                }
                return const SizedBox.shrink();
              },
            ),
        ],
      ),
    );
  }
}

class ChallengeScreen extends StatefulWidget {
  const ChallengeScreen({super.key});

  @override
  State<ChallengeScreen> createState() => _ChallengeScreenState();
}

class _ChallengeScreenState extends State<ChallengeScreen> {
  @override
  void initState() {
    super.initState();

    // ✅ 자동 완료 로직 실행
    Future.delayed(Duration.zero, () {
      final provider = Provider.of<ChallengeProvider>(context, listen: false);
      provider.autoCompleteHabit10MinChallenge();
    });
  }

  @override
  Widget build(BuildContext context) {
    final challengeProvider = context.watch<ChallengeProvider>();
    final joinedChallenges = challengeProvider.visibleJoinedChallenges;
    final notJoinedChallenges = challengeProvider.visibleNotJoinedChallenges;

    return Scaffold(
        backgroundColor: const Color(0xFF013328),
        body: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const SizedBox(height: 60), // 상단 여백 추가
            _buildTopBar(context),
            Expanded(
              child: SingleChildScrollView(
                padding: const EdgeInsets.symmetric(horizontal: 20),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    _buildChallengeGuideEntry(context),
                    const SizedBox(height: 20),
                    Text(
                      "🔥 진행 중인 챌린지 🔥",
                      style: TextStyle(
                          fontSize: 18,
                          fontFamily: 'kopub',
                          fontWeight: FontWeight.bold,
                          color: Colors.white),
                    ),
                    const SizedBox(height: 16),
                    // ✅ 진행 중 챌린지 영역
                    if (joinedChallenges.isEmpty)
                      _buildPlaceholderBox("진행 중인 챌린지가 없습니다.")
                    else
                      Column(
                        children: joinedChallenges.map((c) =>
                            GestureDetector(
                              onTap: () {
                                Navigator.push(
                                  context,
                                  MaterialPageRoute(
                                    builder: (context) =>
                                        ChallengeOngoingScreen(challenge: c),
                                  ),
                                );
                              },
                              child: ChallengeCard(
                                challenge: c,
                                showAttemptsBadge: true,
                              ),
                            )).toList(),
                      ),
                    const Divider(color: Colors.white24, thickness: 1),
                    const SizedBox(height: 20),
                    const Text(
                      "챌린지 생성하기",
                      style: TextStyle(
                          fontSize: 18,
                          fontFamily: 'kopub',
                          fontWeight: FontWeight.bold,
                          color: Colors.white),
                    ),
                    const SizedBox(height: 16),
                    _buildCreateChallengeBox(context),
                    const Divider(color: Colors.white24, thickness: 1),
                    const SizedBox(height: 20),
                    const Text(
                      "챌린지 참여하기",
                      style: TextStyle(
                          fontSize: 18,
                          fontFamily: 'kopub',
                          fontWeight: FontWeight.bold,
                          color: Colors.white),
                    ),
                    const SizedBox(height: 16),
                    Column(
                      children: notJoinedChallenges.map((c) =>
                          GestureDetector(
                            onTap: () {
                              Navigator.push(
                                context,
                                MaterialPageRoute(
                                  builder: (context) =>
                                      ChallengeDetailScreen(challenge: c),
                                ),
                              );
                            },
                            child: ChallengeCard(
                              challenge: c,
                              showAttemptsBadge: true,
                            ),
                          )).toList(),
                    ),
                    const SizedBox(height: 40),
                  ],
                ),
              ),
            ),
          ],
        ),
    );
  }

  Widget _buildChallengeGuideEntry(BuildContext context) {
    final screenWidth = MediaQuery.of(context).size.width;

    return GestureDetector(
      onTap: () {
        Navigator.push(
          context,
          MaterialPageRoute(builder: (_) => const ChallengeIntroScreen()),
        );
      },
      child: ClipRRect(
        borderRadius: BorderRadius.circular(16),
        child: Stack(
          alignment: Alignment.center,
          children: [
            // ✅ 배경 이미지
            Image.asset(
              'assets/image/guide_banner.jpg',
              width: screenWidth,
              height: screenWidth * 0.4,
              fit: BoxFit.cover,
            ),

            // ✅ 반투명 블러 배경 + 텍스트
            Container(
              width: double.infinity,
              height: screenWidth * 0.4,
              color: Colors.black.withOpacity(0.4), // 블러 느낌 배경
              alignment: Alignment.center,
              padding: const EdgeInsets.all(16),
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: const [
                  Text(
                    "챌린지 가이드 보기",
                    style: TextStyle(
                      color: Colors.white,
                      fontFamily: 'kopub',
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  SizedBox(height: 8),
                  Text(
                    "지속적인 습관, 의미 있는 성취,\n새로운 세계로의 확장을 안내합니다.",
                    style: TextStyle(
                      color: Colors.white70,
                      fontFamily: 'kopub',
                      fontSize: 14,
                      fontWeight: FontWeight.bold,
                    ),
                    textAlign: TextAlign.center,
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildPlaceholderBox(String text) {
    return Container(
      margin: const EdgeInsets.only(bottom: 16),
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: Colors.white10,
        borderRadius: BorderRadius.circular(12),
      ),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.center,
        children: [
          Container(
            width: 60,
            height: 60,
            decoration: BoxDecoration(
              color: Colors.white24,
              borderRadius: BorderRadius.circular(8),
            ),
            child: const Icon(Icons.hourglass_empty, color: Colors.white70, size: 32),
          ),
          const SizedBox(width: 16),
          Expanded(
            child: Text(
              text,
              style: const TextStyle(
                fontSize: 16,
                fontFamily: 'kopub',
                fontWeight: FontWeight.w300,
                color: Colors.white70,
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildCreateChallengeBox(BuildContext context) {
    return GestureDetector(
      onTap: () {
        Navigator.push(
          context,
          MaterialPageRoute(builder: (_) => const ChallengeCreateScreen()),
        );
      },
      child: Container(
        margin: const EdgeInsets.only(bottom: 16),
        padding: const EdgeInsets.all(12),
        decoration: BoxDecoration(
          color: Colors.white10,
          borderRadius: BorderRadius.circular(12),
        ),
        child: Row(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Container(
              width: 60,
              height: 60,
              decoration: BoxDecoration(
                color: Colors.white24,
                borderRadius: BorderRadius.circular(8),
              ),
              child: const Icon(Icons.add, color: Colors.amberAccent, size: 32),
            ),
            const SizedBox(width: 16),
            const Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    "챌린지 생성하기",
                    style: TextStyle(
                      color: Colors.white,
                      fontFamily: 'kopub',
                      fontSize: 16,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  SizedBox(height: 6),
                  Text(
                    "나만의 챌린지를 만들어보세요!",
                    style: TextStyle(
                      color: Colors.white70,
                      fontFamily: 'kopub',
                      fontWeight: FontWeight.w300,
                      fontSize: 15,
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildTopBar(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 10),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          const Text(
            "CHALLENGE",
            style: TextStyle(
              color: Colors.white,
              fontFamily: 'kopub',
              fontSize: 20,
              fontWeight: FontWeight.w600,
              letterSpacing: 1.5,
            ),
          ),
        ],
      ),
    );
  }
}
