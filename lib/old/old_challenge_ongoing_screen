import 'package:flutter/material.dart';
import 'package:dayverse_book/model/challenge_model.dart';
import 'package:dayverse_book/provider/challenge_provider.dart';
import 'package:dayverse_book/provider/saved_books_provider.dart';
import 'package:provider/provider.dart';
import 'package:dayverse_book/utils/challenge_progress_utils.dart';
import 'package:dayverse_book/screen/challenge_screen.dart';
import 'package:dayverse_book/screen/challenge_edit_screen.dart';
import 'dart:io';

class ChallengeOngoingScreen extends StatefulWidget {
  final Challenge challenge;

  const ChallengeOngoingScreen({super.key, required this.challenge});

  @override
  _ChallengeOngoingScreenState createState() => _ChallengeOngoingScreenState();
}

class _ChallengeOngoingScreenState extends State<ChallengeOngoingScreen> {
  @override
  Widget build(BuildContext context) {
    final challengeProvider = Provider.of<ChallengeProvider>(context);
    final savedBooks = Provider.of<SavedBooksProvider>(context).savedBooks;

    final currentDate = DateTime.now();
    final today =
        DateTime(currentDate.year, currentDate.month, currentDate.day);
    final end = DateTime(widget.challenge.endDate.year,
        widget.challenge.endDate.month, widget.challenge.endDate.day);
    final difference = end.difference(today).inDays + 1;

    final progress =
        ChallengeProgressUtils.getProgress(widget.challenge, savedBooks);
    final completed =
        ChallengeProgressUtils.getCompletedCount(widget.challenge, savedBooks);

    if (progress >= 1.0 && !widget.challenge.isCompleted) {
      challengeProvider.markChallengeAsCompleted(widget.challenge);

      WidgetsBinding.instance.addPostFrameCallback((_) {
        showDialog(
          context: context,
          barrierDismissible: false,
          builder: (_) {
            return AlertDialog(
              backgroundColor: Colors.greenAccent,
              shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(12)),
              content: SizedBox(
                child: Row(
                  children: [
                    const Icon(Icons.emoji_events,
                        color: Colors.deepPurple, size: 36),
                    const SizedBox(width: 10),
                    Expanded(
                      child: Text(
                        "🎉 축하합니다! 🎉 \n'${widget.challenge.title}' 챌린지를 \n 달성했습니다!",
                        style: const TextStyle(
                            color: Colors.black,
                            fontFamily: 'kopub',
                            fontWeight: FontWeight.bold,
                            fontSize: 18),
                      ),
                    ),
                  ],
                ),
              ),
            );
          },
        );

        Future.delayed(const Duration(milliseconds: 1500), () {
          if (context.mounted) {
            Navigator.pop(context);
            Navigator.of(context).pushAndRemoveUntil(
              MaterialPageRoute(builder: (context) => const ChallengeScreen()),
              (route) => route.isFirst,
            );
          }
        });
      });
    }

    return GestureDetector(
      onHorizontalDragUpdate: (details) {
        if (details.delta.dx > 10) {
          Navigator.pop(context);
        }
      },
      child: Scaffold(
        backgroundColor: const Color(0xFF013328),
        appBar: AppBar(
          backgroundColor: Colors.transparent,
          elevation: 0,
          leading: IconButton(
            icon: const Icon(Icons.arrow_back, color: Colors.white),
            onPressed: () {
              Navigator.pushReplacement(
                context,
                MaterialPageRoute(builder: (_) => const ChallengeScreen()),
              );
            },
          ),
          title: Text(
            widget.challenge.title,
            style: const TextStyle(
              color: Colors.white,
              fontFamily: 'kopub',
              fontSize: 20,
              fontWeight: FontWeight.bold,
            ),
          ),
          actions: [
            if (widget.challenge.isCustom)
              IconButton(
                icon: const Icon(Icons.edit, color: Colors.white),
                onPressed: () {
                  Navigator.push(
                    context,
                    MaterialPageRoute(
                      builder: (_) =>
                          ChallengeEditScreen(challenge: widget.challenge),
                    ),
                  );
                },
              ),
          ],
        ),
        body: Stack(
          children: [
            SingleChildScrollView(
              padding: const EdgeInsets.all(20),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  ClipRRect(
                    borderRadius: BorderRadius.circular(12),
                    child: _buildChallengeImage(),
                  ),
                  const SizedBox(height: 20),
                  const Divider(color: Colors.white24),
                  const SizedBox(height: 20),
                  Text(
                    widget.challenge.title,
                    style: const TextStyle(
                      color: Colors.white,
                      fontFamily: 'kopub',
                      fontSize: 24,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  const SizedBox(height: 8),
                  Text(
                    "$difference일 남았습니다",
                    style: const TextStyle(
                      color: Colors.amberAccent,
                      fontFamily: 'kopub',
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  const SizedBox(height: 20),
                  _buildProgressSection(widget.challenge, savedBooks),
                  if (widget.challenge.type == ChallengeType.specificBooks)
                    _buildRequiredBooksSection(widget.challenge, savedBooks),
                  const SizedBox(height: 20),
                  Text(
                    "챌린지 상세",
                    style: TextStyle(
                        color: Colors.white,
                        fontFamily: 'kopub',
                        fontSize: 18,
                        fontWeight: FontWeight.bold),
                  ),
                  const SizedBox(height: 12),
                  _buildInfoCard("총 권수", "${widget.challenge.totalBooks}권"),
                  _buildInfoCard(
                      "도전 기간",
                      _formatDateRange(widget.challenge.startDate,
                          widget.challenge.endDate)),
                  const SizedBox(height: 12),
                  Text(
                    widget.challenge.description,
                    style: const TextStyle(
                      color: Colors.white70,
                      fontFamily: 'kopub',
                      fontSize: 16,
                      height: 1.6,
                    ),
                  ),
                  const SizedBox(height: 150),
                ],
              ),
            ),
            Align(
              alignment: Alignment.bottomCenter,
              child: Padding(
                padding: const EdgeInsets.only(bottom: 40.0),
                child: SizedBox(
                  width: MediaQuery.of(context).size.width * 0.9,
                  child: ElevatedButton(
                    onPressed: () {
                      showDialog(
                        context: context,
                        builder: (context) {
                          return AlertDialog(
                            backgroundColor: const Color(0xFF0A1D27),
                            shape: RoundedRectangleBorder(
                                borderRadius: BorderRadius.circular(12)),
                            title: const Text("정말로 포기하시겠어요?",
                                style: TextStyle(
                                    color: Colors.white,
                                    fontFamily: 'kopub',
                                    fontSize: 18,
                                    fontWeight: FontWeight.bold)),
                            content: const Text(
                                "지금 포기하면 챌린지 진행 정보가 사라집니다.\n그래도 포기하시겠어요?",
                                style: TextStyle(
                                    color: Colors.white70,
                                    fontFamily: 'kopub',
                                    fontSize: 16)),
                            actions: [
                              TextButton(
                                onPressed: () {
                                  Navigator.pop(context); // 다이얼로그 먼저 닫기
                                  challengeProvider
                                      .unjoinChallenge(widget.challenge);
                                  Navigator.pop(
                                      context); // ChallengeOngoingScreen 닫기
                                },
                                child: const Text("포기하기",
                                    style: TextStyle(
                                        color: Colors.redAccent,
                                        fontFamily: 'kopub',
                                        fontWeight: FontWeight.bold)),
                              ),
                              TextButton(
                                onPressed: () {
                                  Navigator.pop(context); // 다이얼로그 닫기
                                },
                                child: const Text("취소",
                                    style: TextStyle(
                                      color: Colors.white54,
                                      fontFamily: 'kopub',
                                    )),
                              ),
                            ],
                          );
                        },
                      );
                    },
                    style: ElevatedButton.styleFrom(
                      backgroundColor: Colors.redAccent,
                      padding: const EdgeInsets.symmetric(
                          vertical: 20, horizontal: 50),
                      shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(18)),
                    ),
                    child: const Text(
                      "챌린지 포기하기",
                      style: TextStyle(
                          fontSize: 18,
                          color: Colors.white,
                          fontFamily: 'kopub',
                          fontWeight: FontWeight.bold),
                    ),
                  ),
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildInfoCard(String title, String value) {
    return Container(
      margin: const EdgeInsets.only(bottom: 10),
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: Colors.white10,
        borderRadius: BorderRadius.circular(12),
      ),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(
            title,
            style: const TextStyle(
                color: Colors.white70, fontFamily: 'kopub', fontSize: 16),
          ),
          Text(
            value,
            style: const TextStyle(
                color: Colors.white, fontFamily: 'kopub', fontSize: 16),
          ),
        ],
      ),
    );
  }

  Widget _buildProgressSection(
      Challenge challenge, List<Map<String, dynamic>> savedBooks) {
    final progress = ChallengeProgressUtils.getProgress(challenge, savedBooks);
    final completed =
        ChallengeProgressUtils.getCompletedCount(challenge, savedBooks);
    final total = ChallengeProgressUtils.getTargetCount(challenge);
    final progressPercent = (progress * 100).floor();
    final isSpecific = challenge.type == ChallengeType.specificBooks;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          isSpecific
              ? "$completed / $total권 완료 (지정 도서)"
              : "$completed / $total권 완료",
          style: const TextStyle(
            color: Colors.white,
            fontFamily: 'kopub',
            fontSize: 20,
            fontWeight: FontWeight.bold,
          ),
        ),
        const SizedBox(height: 10),
        LinearProgressIndicator(
          value: progress,
          backgroundColor: Colors.white24,
          color: Colors.amberAccent,
          minHeight: 12,
          borderRadius: BorderRadius.circular(10),
        ),
        const SizedBox(height: 8),
        Text(
          "$progressPercent%",
          style: const TextStyle(
              color: Colors.white70, fontFamily: 'kopub', fontSize: 16),
        ),
        const SizedBox(height: 20),
      ],
    );
  }

  Widget _buildRequiredBooksSection(
      Challenge challenge, List<Map<String, dynamic>> savedBooks) {
    final readIds = savedBooks
        .where((book) =>
            book['category'] == 'done' &&
            ChallengeProgressUtils.isWithinChallengePeriod(
                book['endDate'], challenge))
        .map((book) => book['id'].toString())
        .toSet();

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text(
          "지정 도서 목록",
          style: TextStyle(
              color: Colors.white,
              fontFamily: 'kopub',
              fontSize: 18,
              fontWeight: FontWeight.bold),
        ),
        const SizedBox(height: 12),
        ...(challenge.requiredBooks ?? []).map<Widget>((book) {
          final isRead = readIds.contains(book['id']);
          return Container(
            margin: const EdgeInsets.only(bottom: 8),
            padding: const EdgeInsets.symmetric(vertical: 10, horizontal: 12),
            decoration: BoxDecoration(
              color:
                  isRead ? Colors.greenAccent.withOpacity(0.3) : Colors.white10,
              borderRadius: BorderRadius.circular(8),
            ),
            child: Row(
              children: [
                Icon(
                  isRead ? Icons.check_circle : Icons.radio_button_unchecked,
                  color: isRead ? Colors.greenAccent : Colors.white38,
                ),
                const SizedBox(width: 10),
                Expanded(
                  child: Text(
                    "${book['title']} (${book['author']})",
                    style: const TextStyle(
                        color: Colors.white, fontFamily: 'kopub', fontSize: 15),
                  ),
                ),
              ],
            ),
          );
        }).toList(),
      ],
    );
  }

  String _formatDateRange(DateTime start, DateTime end) {
    String formatDate(DateTime d) =>
        "${d.year}.${d.month.toString().padLeft(2, '0')}.${d.day.toString().padLeft(2, '0')}";
    return "${formatDate(start)} ~ ${formatDate(end)}";
  }

  Widget _buildChallengeImage() {
    final imageUrl = widget.challenge.imageUrl.trim();

    if (imageUrl.isEmpty) {
      return Container(
        width: double.infinity,
        height: 200,
        color: Colors.grey,
        child: const Icon(Icons.flag, color: Colors.white, size: 50),
      );
    }

    // asset 이미지
    if (imageUrl.startsWith("assets/")) {
      return Image.asset(
        imageUrl,
        width: double.infinity,
        height: 200,
        fit: BoxFit.cover,
        errorBuilder: (context, error, stackTrace) => Container(
          width: double.infinity,
          height: 200,
          color: Colors.grey,
          child: const Icon(Icons.error, color: Colors.white),
        ),
      );
    }

    // 파일 이미지
    final file = File(imageUrl);
    if (!file.existsSync()) {
      return Container(
        width: double.infinity,
        height: 200,
        color: Colors.grey,
        child: const Icon(Icons.broken_image, color: Colors.white),
      );
    }

    return Image.file(
      file,
      width: double.infinity,
      height: 200,
      fit: BoxFit.cover,
    );
  }
}
