import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:dayverse_book/model/challenge_model.dart';
import 'package:provider/provider.dart';
import 'package:dayverse_book/provider/challenge_provider.dart';
import 'package:dayverse_book/provider/saved_books_provider.dart';
import 'package:image_picker/image_picker.dart';
import 'dart:io';
import 'package:dayverse_book/screen/challenge_ongoing_screen.dart';
import 'package:dayverse_book/utils/book_utils.dart';
import 'challenge_create_screen.dart';

class ChallengeEditScreen extends StatefulWidget {
  final Challenge challenge;

  const ChallengeEditScreen({super.key, required this.challenge});

  @override
  _ChallengeEditScreenState createState() => _ChallengeEditScreenState();
}

class _ChallengeEditScreenState extends State<ChallengeEditScreen> {
  late TextEditingController _titleController;
  late TextEditingController _descriptionController;
  late TextEditingController _totalBooksController;
  late TextEditingController _searchController;

  late ChallengeType _selectedType;
  late DateTime _startDate;
  late DateTime _endDate;
  late List<Map<String, String>> _specificBooks;
  List<Map<String, String>> _searchResults = [];

  File? _selectedImage;

  @override
  void initState() {
    super.initState();
    final challenge = widget.challenge;

    _titleController = TextEditingController(text: challenge.title);
    _descriptionController = TextEditingController(text: challenge.description);
    _totalBooksController = TextEditingController(text: challenge.totalBooks.toString());
    _searchController = TextEditingController();

    _selectedType = challenge.type;
    _startDate = challenge.startDate;
    _endDate = challenge.endDate;
    _specificBooks = List<Map<String, String>>.from(challenge.requiredBooks ?? []);

    if (challenge.imageUrl.isNotEmpty && !challenge.imageUrl.startsWith("asset/")) {
      _selectedImage = File(challenge.imageUrl);
    }
  }

  void _onSearchChanged(String query) {
    final dummyBooks = [
      {"title": "그릿", "author": "앤절라 더크워스", "isbn": "9791162540633"},
      {"title": "차라투스트라는 이렇게 말했다", "author": "프리드리히 니체", "isbn": "9788991799375"},
      {"title": "니체의 말", "author": "프리드리히 니체", "isbn": "788970123456"},
      {"title": "도덕의 계보", "author": "프리드리히 니체", "isbn": "65498498"},
      {
        "title": "good_test",
        "author": "asd",
        "isbn": "91130620456",
      },
      {
        "title": "good_test2",
        "author": "aaadc",
        "isbn": "1130620456",
      },
      {
        "title": "good_test3",
        "author": "good_test3",
        "isbn": "130620456",
      },
    ];

    if (query.trim().isEmpty) {
      setState(() {
        _searchResults = [];
      });
      return;
    }

    final results = dummyBooks.where((book) =>
    (book['title']!.toLowerCase().contains(query.toLowerCase()) ||
        book['author']!.toLowerCase().contains(query.toLowerCase()))
    ).toList();

    // ✅ 반드시 setState()로 감싸야 함!
    setState(() {
      _searchResults = results;
    });
  }

  void _addSpecificBook(Map<String, dynamic> book) {
    final id = generateBookId(book['isbn'] ?? '', book['title'] ?? '', book['author'] ?? '');
    final alreadyExists = _specificBooks.any((b) => b['id'] == id);

    if (!alreadyExists) {
      setState(() {
        _specificBooks.add({
          "id": id,
          "title": book['title'] ?? '',
          "author": book['author'] ?? '',
        });
        _totalBooksController.text = _specificBooks.length.toString();
      });
    } else {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text("이미 추가된 책입니다.", style: TextStyle(color: Colors.black)),
          backgroundColor: Colors.amberAccent,
          duration: Duration(milliseconds: 1500),
        ),
      );
    }
  }

  void _removeSpecificBook(Map<String, String> book) {
    setState(() {
      _specificBooks.remove(book);
      _totalBooksController.text = _specificBooks.length.toString();
    });
  }

  Future<void> _pickImage() async {
    final picker = ImagePicker();
    final pickedFile = await picker.pickImage(source: ImageSource.gallery);
    if (pickedFile != null) {
      setState(() {
        _selectedImage = File(pickedFile.path);
      });
    }
  }

  Future<void> _pickDate({required bool isStart}) async {
    final picked = await showDatePicker(
      context: context,
      initialDate: isStart ? _startDate : _endDate,
      firstDate: DateTime(2000),
      lastDate: DateTime(2100),
    );
    if (picked != null) {
      setState(() {
        if (isStart) {
          _startDate = picked;
          if (_endDate.isBefore(_startDate)) _endDate = _startDate;
        } else {
          _endDate = picked;
        }
      });
    }
  }

  String _formatDate(DateTime date) {
    return "${date.year}.${date.month.toString().padLeft(2, '0')}.${date.day.toString().padLeft(2, '0')}";
  }

  void _updateChallenge() {
    final title = _titleController.text.trim();
    final description = _descriptionController.text.trim();
    final totalBooks = int.tryParse(_totalBooksController.text.trim()) ?? 0;

    if (title.isEmpty || totalBooks <= 0 || _startDate.isAfter(_endDate)) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text("모든 필수 항목을 올바르게 입력해주세요.")),
      );
      return;
    }

    final updatedChallenge = widget.challenge.copyWith(
      title: title,
      description: description,
      imageUrl: _selectedImage?.path ?? widget.challenge.imageUrl,
      totalBooks: totalBooks,
      type: _selectedType,
      startDate: _startDate,
      endDate: _endDate,
      requiredBooks: _selectedType == ChallengeType.specificBooks ? _specificBooks : null,
    );

    final challengeProvider = Provider.of<ChallengeProvider>(context, listen: false);
    challengeProvider.updateChallenge(updatedChallenge);

    showDialog(
      barrierDismissible: false,
      context: context,
      builder: (context) {
        return AlertDialog(
          backgroundColor: Colors.greenAccent,
          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
          content: Row(
            children: [
              const Icon(Icons.check_circle, color: Colors.deepPurple, size: 36),
              const SizedBox(width: 10),
              Expanded(
                child: Text(
                  "'${updatedChallenge.title}'\n수정이 완료되었습니다!\n응원합니다 💪",
                  style: const TextStyle(color: Colors.black, fontFamily: 'kopub', fontWeight: FontWeight.bold, fontSize: 16),
                ),
              ),
            ],
          ),
        );
      },
    );

    Future.delayed(const Duration(milliseconds: 1500), () {
      if (!mounted) return;
      Navigator.pop(context);
      Navigator.pushReplacement(
        context,
        MaterialPageRoute(builder: (_) => ChallengeOngoingScreen(challenge: updatedChallenge)),
      );
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF013328),
      appBar: AppBar(
        backgroundColor: Colors.transparent,
        elevation: 0,
        title: const Text("챌린지 편집하기", style: TextStyle(color: Colors.white, fontFamily: 'kopub')),
        leading: IconButton(
          icon: const Icon(Icons.arrow_back, color: Colors.white),
          onPressed: () => Navigator.pop(context),
        ),
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text("1. 챌린지 제목", style: TextStyle(color: Colors.white, fontFamily: 'kopub', fontSize: 16)),
            const SizedBox(height: 8),
            _buildTextField("챌린지 이름을 입력하세요", _titleController),
            const SizedBox(height: 20),
            const Text("2. 챌린지 유형", style: TextStyle(color: Colors.white, fontFamily: 'kopub', fontSize: 16)),
            const SizedBox(height: 8),
            _buildChallengeTypeSelector(),
            const SizedBox(height: 20),
            if (_selectedType == ChallengeType.specificBooks) _buildSpecificBooksInput(),
            const Text("3. 총 권수", style: TextStyle(color: Colors.white, fontFamily: 'kopub', fontSize: 16)),
            const SizedBox(height: 8),
            _buildTotalBooksField(),
            const SizedBox(height: 20),
            const Text("4. 도전 기간", style: TextStyle(color: Colors.white, fontFamily: 'kopub', fontSize: 16)),
            const SizedBox(height: 8),
            _buildDateSelector(),
            const SizedBox(height: 20),
            const Text("5. 챌린지 설명", style: TextStyle(color: Colors.white, fontFamily: 'kopub', fontSize: 16)),
            const SizedBox(height: 8),
            _buildTextField("챌린지에 대해 설명해주세요", _descriptionController, maxLines: 3),
            const SizedBox(height: 20),
            _buildImagePickerSection(),
            const SizedBox(height: 40),
            _buildSubmitButton(),
          ],
        ),
      ),
    );
  }

  Widget _buildTextField(String hint, TextEditingController controller, {bool isNumber = false, int maxLines = 1}) {
    return TextField(
      controller: controller,
      keyboardType: isNumber ? TextInputType.number : TextInputType.text,
      inputFormatters: isNumber ? [FilteringTextInputFormatter.digitsOnly] : null,
      maxLines: maxLines,
      style: const TextStyle(color: Colors.white),
      decoration: InputDecoration(
        hintText: hint,
        hintStyle: const TextStyle(color: Colors.white54),
        filled: true,
        fillColor: Colors.white12,
        border: OutlineInputBorder(
          borderRadius: BorderRadius.circular(8),
          borderSide: BorderSide.none,
        ),
      ),
    );
  }

  Widget _buildChallengeTypeSelector() {
    return DropdownButtonFormField<ChallengeType>(
      value: _selectedType,
      dropdownColor: const Color(0xFF013328),
      decoration: InputDecoration(
        filled: true,
        fillColor: Colors.white12,
        border: OutlineInputBorder(
          borderRadius: BorderRadius.circular(8),
          borderSide: BorderSide.none,
        ),
      ),
      style: const TextStyle(color: Colors.white),
      items: const [
        DropdownMenuItem(value: ChallengeType.totalBooks, child: Text("총 권수 챌린지", style: TextStyle(color: Colors.white, fontFamily: 'kopub'))),
        DropdownMenuItem(value: ChallengeType.specificBooks, child: Text("지정도서 챌린지", style: TextStyle(color: Colors.white, fontFamily: 'kopub'))),
      ],
      onChanged: (value) {
        setState(() {
          _selectedType = value!;
        });
      },
    );
  }

  Widget _buildSpecificBooksInput() {
    return SearchBoxWithResults(
      searchController: _searchController,
      searchResults: _searchResults,
      selectedBooks: _specificBooks,
      onSearchChanged: _onSearchChanged,
      onBookSelected: _addSpecificBook,
      onBookRemoved: _removeSpecificBook,
    );
  }

  Widget _buildTotalBooksField() {
    return TextField(
      controller: _totalBooksController
        ..text = _selectedType == ChallengeType.specificBooks ? _specificBooks.length.toString() : _totalBooksController.text,
      readOnly: true,
      style: const TextStyle(color: Colors.white),
      decoration: InputDecoration(
        hintText: "지정 도서 수에 따라 자동 입력됩니다",
        hintStyle: const TextStyle(color: Colors.white54),
        filled: true,
        fillColor: Colors.white12,
        border: OutlineInputBorder(
          borderRadius: BorderRadius.circular(8),
          borderSide: BorderSide.none,
        ),
      ),
    );
  }

  Widget _buildDateSelector() {
    return Row(
      children: [
        Expanded(child: _buildDateButton("시작일: ${_formatDate(_startDate)}", () => _pickDate(isStart: true))),
        const SizedBox(width: 12),
        Expanded(child: _buildDateButton("종료일: ${_formatDate(_endDate)}", () => _pickDate(isStart: false))),
      ],
    );
  }

  Widget _buildDateButton(String label, VoidCallback onPressed) {
    return TextButton(
      onPressed: onPressed,
      style: TextButton.styleFrom(
        padding: const EdgeInsets.symmetric(vertical: 12),
        backgroundColor: Colors.white12,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
      ),
      child: Text(label, style: const TextStyle(color: Colors.white, fontFamily: 'kopub')),
    );
  }

  Widget _buildImagePickerSection() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text("6. 챌린지 대표 이미지",
            style: TextStyle(
                color: Colors.white, fontFamily: 'kopub', fontSize: 16)),
        const SizedBox(height: 8),
        GestureDetector(
          onTap: _pickImage,
          child: Container(
            width: double.infinity,
            height: 180,
            decoration: BoxDecoration(
              color: Colors.white10,
              borderRadius: BorderRadius.circular(12),
              image: _selectedImage != null
                  ? DecorationImage(
                  image: FileImage(_selectedImage!), fit: BoxFit.cover)
                  : null,
            ),
            child: _selectedImage == null
                ? const Center(
              child: Text("이미지를 선택하려면 탭하세요",
                  style: TextStyle(
                    color: Colors.white54,
                    fontFamily: 'kopub',
                  )),
            )
                : null,
          ),
        ),
      ],
    );
  }

  Widget _buildSubmitButton() {
    return ElevatedButton(
      onPressed: _updateChallenge,
      style: ElevatedButton.styleFrom(
        backgroundColor: Colors.amberAccent,
        padding: const EdgeInsets.symmetric(vertical: 16),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
      ),
      child: const Center(
        child: Text("수정 완료", style: TextStyle(color: Colors.black, fontFamily: 'kopub', fontSize: 16, fontWeight: FontWeight.bold)),
      ),
    );
  }

}
