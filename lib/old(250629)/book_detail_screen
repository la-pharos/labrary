import 'package:flutter/material.dart';
import 'package:intl/intl.dart';
import 'package:provider/provider.dart';
import 'package:dayverse_book/model/book_model.dart';
import 'package:dayverse_book/provider/saved_books_provider.dart';
import 'package:dayverse_book/provider/custom_library_provider.dart';
import 'package:dayverse_book/widget/calendar_widget.dart';


class BookDetailScreen extends StatelessWidget {
  final BookModel book;

  const BookDetailScreen({super.key, required this.book});

  @override
  Widget build(BuildContext context) {
    final records = context.watch<SavedBooksProvider>().getRecordsForBook(book.id);

    return GestureDetector(
      onHorizontalDragUpdate: (details) {
        if (details.delta.dx > 20) Navigator.pop(context);
      },
      child: Scaffold(
        backgroundColor: const Color(0xFF0A1D27),
        appBar: AppBar(
          backgroundColor: Colors.transparent,
          elevation: 0,
          leading: IconButton(
            icon: const Icon(Icons.arrow_back, color: Colors.white),
            onPressed: () => Navigator.pop(context),
          ),
          actions: [
            IconButton(
              icon: const Icon(Icons.delete, color: Colors.white),
              onPressed: () => _confirmDeleteBook(context),
            ),
          ],
        ),
        body: SingleChildScrollView(
          padding: const EdgeInsets.all(20),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              _buildBookInfo(),
              const SizedBox(height: 12),
              const Divider(color: Colors.white38, thickness: 1, height: 30),
              _buildReadingStatus(context),
              const SizedBox(height: 10),
              _buildLibrarySection(context),
              const SizedBox(height: 10),
              _buildMemoSection(context, records),
            ],
          ),
        ),
      ),
    );
  }

  /// 책 정보
  Widget _buildBookInfo() {
    final isbn = (book.isbn?.isNotEmpty == true) ? book.isbn! : "알 수 없음";
    final pageCount = (book.pageCount > 0) ? "${book.pageCount}쪽" : "알 수 없음";

    return Row(
      crossAxisAlignment: CrossAxisAlignment.center,
      children: [
        ClipRRect(
          borderRadius: BorderRadius.circular(12),
          child: () {
            final highResImageUrl = (book.imageUrl ?? '').replaceAll('coversum', 'cover');
            return (highResImageUrl.startsWith("http"))
                ? Image.network(
              highResImageUrl,
              width: 120,
              height: 170,
              fit: BoxFit.contain,
              errorBuilder: (_, __, ___) => _fallbackImage(),
            )
                : _fallbackImage();
          }(),
        ),
        const SizedBox(width: 15),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(book.title,
                  maxLines: 2,
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(
                      color: Colors.white,
                      fontFamily: 'kopub',
                      fontSize: 22,
                      fontWeight: FontWeight.bold)),
              const SizedBox(height: 5),
              Text("저자: ${book.author}",
                  style: _infoStyle()),
              const SizedBox(height: 3),
              Text("출판사: ${book.publisher}",
                  style: _infoStyle()),
              const SizedBox(height: 3),
              Text("ISBN: $isbn",
                  style: _infoStyle()),
              const SizedBox(height: 3),
              Text("총 페이지수: $pageCount",
                  style: _infoStyle()),
            ],
          ),
        ),
      ],
    );
  }

  TextStyle _infoStyle() {
    return const TextStyle(
        color: Colors.white70,
        fontFamily: 'kopub',
        fontWeight: FontWeight.bold,
        fontSize: 16);
  }

  Widget _fallbackImage() {
    return Container(
      width: 120,
      height: 170,
      color: Colors.grey,
      child: const Icon(Icons.book, color: Colors.white, size: 40),
    );
  }

  /// 독서 상태
  Widget _buildReadingStatus(BuildContext context) {
    return Container(
      decoration: BoxDecoration(
        color: const Color(0xFF0A1D27),
        borderRadius: BorderRadius.circular(8),
      ),
      child: Row(
        children: [
          GestureDetector(
            onTap: () => _changeCategory(context),
            child: Container(
              width: 32,
              height: 32,
              decoration: BoxDecoration(
                color: const Color(0xFF0A1D27),
                borderRadius: BorderRadius.circular(6),
              ),
              child: const Icon(Icons.book, size: 25, color: Colors.amberAccent),
            ),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Text(
              _getCategoryDescription(book),
              style: const TextStyle(
                  fontSize: 16,
                  fontFamily: "Kopub",
                  fontWeight: FontWeight.w500,
                  color: Colors.white),
            ),
          ),
        ],
      ),
    );
  }

  String _getCategoryDescription(BookModel book) {
    final start = book.startDate != null ? DateFormat('yy/MM/dd').format(book.startDate!) : "";
    final end = book.endDate != null ? DateFormat('yy/MM/dd').format(book.endDate!) : "";
    switch (book.category) {
      case "done":
        return "$start ~ $end 동안 읽었어요!";
      case "reading":
        return "$start 부터 읽고 있어요!";
      case "want":
        return "곧 읽을 책이에요!";
      default:
        return "";
    }
  }

  void _changeCategory(BuildContext context) {
    showModalBottomSheet(
      context: context,
      builder: (_) {
        return Container(
          padding: const EdgeInsets.all(20),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              // ✅ 읽은 책
              ListTile(
                title: const Text("읽은 책", style: TextStyle(fontFamily: 'kopub')),
                onTap: () {
                  DateTime now = DateTime.now();
                  showCalendarDialog(
                    context: context,
                    isStartDate: true,
                    selectedDate: now,
                    minDate: DateTime(2000),
                    maxDate: now,
                    onDatePicked: (start) {
                      showCalendarDialog(
                        context: context,
                        isStartDate: false,
                        selectedDate: now,
                        minDate: start,
                        maxDate: now,
                        onDatePicked: (end) {
                          Navigator.of(context).pop();
                          _updateCategory(context, "done", startDate: start, endDate: end);
                        },
                      );
                    },
                  );
                },
              ),

              // ✅ 읽는 중인 책
              ListTile(
                title: const Text("읽는 중인 책", style: TextStyle(fontFamily: 'kopub')),
                onTap: () {
                  DateTime now = DateTime.now();
                  showCalendarDialog(
                    context: context,
                    isStartDate: true,
                    selectedDate: now,
                    minDate: DateTime(2000),
                    maxDate: now,
                    onDatePicked: (start) {
                      Navigator.of(context).pop();
                      _updateCategory(context, "reading", startDate: start);
                    },
                  );
                },
              ),

              // ✅ 읽을 예정인 책
              ListTile(
                title: const Text("읽을 예정인 책", style: TextStyle(fontFamily: 'kopub')),
                onTap: () {
                  Navigator.of(context).pop();
                  _updateCategory(context, "want");
                },
              ),
            ],
          ),
        );
      },
    );
  }

  void _updateCategory(BuildContext context, String newCategory,
      {DateTime? startDate, DateTime? endDate}) {
    final provider = Provider.of<SavedBooksProvider>(context, listen: false);
    provider.updateCategory(book.id, newCategory);
    provider.updateBookDates(book.id, startDate: startDate, endDate: endDate);
    Navigator.pop(context);
  }

  /// 담긴 서재
  Widget _buildLibrarySection(BuildContext context) {
    final provider = Provider.of<CustomLibraryProvider>(context);
    final libraries = provider.getLibrariesContainingBook(book.id);

    return Container(
      decoration: BoxDecoration(
        color: const Color(0xFF0A1D27),
        borderRadius: BorderRadius.circular(8),
      ),
      child: Row(
        children: [
          GestureDetector(
            onTap: () => _openLibraryAssignDialog(context),
            child: Container(
              width: 32,
              height: 32,
              decoration: BoxDecoration(
                color: const Color(0xFF0A1D27),
                borderRadius: BorderRadius.circular(6),
              ),
              child: const Icon(Icons.folder, size: 25, color: Colors.amberAccent),
            ),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: (libraries.isEmpty)
                ? const Text("아직 어떤 서재에도 속해있지 않아요.",
                style: TextStyle(color: Colors.white, fontSize: 16))
                : Wrap(
              spacing: 6,
              runSpacing: 4,
              children: libraries.map((name) {
                return Container(
                  padding: const EdgeInsets.symmetric(
                      vertical: 4, horizontal: 10),
                  decoration: BoxDecoration(
                    color: Colors.white10,
                    borderRadius: BorderRadius.circular(20),
                  ),
                  child: Text(name,
                      style: const TextStyle(
                          color: Colors.white,
                          fontFamily: 'kopub',
                          fontSize: 16)),
                );
              }).toList(),
            ),
          ),
        ],
      ),
    );
  }

  void _openLibraryAssignDialog(BuildContext context) {
    final provider = Provider.of<CustomLibraryProvider>(context, listen: false);
    final libraries = provider.libraries;

    if (libraries.isEmpty) {
      showDialog(
        context: context,
        builder: (_) => AlertDialog(
          backgroundColor: Colors.white,
          title: const Text("등록된 서재가 없습니다",
              style: TextStyle(color: Color(0xFF0A1D27), fontFamily: 'kopub')),
          content: const Text("서재에 추가하려면 먼저 서재를 생성해주세요!",
              style: TextStyle(color: Color(0xFF0A1D27), fontFamily: 'kopub')),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(context),
              child: const Text("확인",
                  style: TextStyle(color: Colors.amberAccent, fontFamily: 'kopub')),
            )
          ],
        ),
      );
      return;
    }

    showModalBottomSheet(
      context: context,
      backgroundColor: Colors.white,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(20)),
      ),
      builder: (_) {
        return StatefulBuilder(builder: (context, setModalState) {
          return Padding(
            padding: const EdgeInsets.all(20),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: libraries.keys.map((name) {
                final isInLibrary = libraries[name]?.contains(book.id) ?? false;
                return CheckboxListTile(
                  title: Text(name,
                      style: const TextStyle(
                          color: Color(0xFF0A1D27),
                          fontFamily: 'kopub',
                          fontWeight: FontWeight.bold)),
                  value: isInLibrary,
                  activeColor: Colors.amberAccent,
                  checkColor: Colors.black,
                  onChanged: (value) {
                    setModalState(() {
                      if (value == true) {
                        provider.addBookToLibrary(name, book.id);
                      } else {
                        provider.removeBookFromCustomLibrary(name, book.id);
                      }
                    });
                  },
                );
              }).toList(),
            ),
          );
        });
      },
    );
  }

  /// 메모
  Widget _buildMemoSection(BuildContext context, List<Map<String, dynamic>> records) {
    final memos = records.where((r) => r['content'] != '독서 타이머 기록').toList();

    return Row(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        GestureDetector(
          onTap: () => _openRecordEditor(context),
          child: Container(
            width: 32,
            height: 32,
            decoration: BoxDecoration(
              color: const Color(0xFF0A1D27),
              borderRadius: BorderRadius.circular(6),
            ),
            child: const Icon(Icons.edit_note_outlined, size: 25, color: Colors.amberAccent),
          ),
        ),
        const SizedBox(width: 12),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              if (memos.isEmpty)
                Container(
                  height: 32,
                  alignment: Alignment.centerLeft,
                  child: GestureDetector(
                    onTap: () => _openRecordEditor(context),
                    child: const Text(
                      "아이콘을 눌러 기록을 남겨보세요.",
                      style: TextStyle(color: Colors.white, fontSize: 16),
                      overflow: TextOverflow.ellipsis,
                    ),
                  ),
                ),
              if (memos.isNotEmpty)
                ...memos.map((record) => _buildMemoItem(context, record)).toList(),
            ],
          ),
        ),
      ],
    );
  }

  Widget _buildMemoItem(BuildContext context, Map<String, dynamic> record) {
    return Dismissible(
      key: UniqueKey(),
      direction: DismissDirection.endToStart,
      confirmDismiss: (_) async {
        final confirm = await showDialog<bool>(
          context: context,
          builder: (ctx) => AlertDialog(
            title: const Text("기록 삭제", style: TextStyle(fontFamily: 'kopub', fontWeight: FontWeight.bold)),
            content: const Text("이 기록을 삭제할까요?", style: TextStyle(fontFamily: 'kopub', fontSize: 16)),
            actions: [
              TextButton(
                onPressed: () => Navigator.of(ctx).pop(true),
                child: const Text("삭제", style: TextStyle(color: Colors.redAccent)),
              ),
              TextButton(
                onPressed: () => Navigator.of(ctx).pop(false),
                child: const Text("취소"),
              ),
            ],
          ),
        );

        if (confirm == true) {
          final provider = Provider.of<SavedBooksProvider>(context, listen: false);
          await provider.deleteRecord(
            book.id,
            record['savedAt'],
            record['content'],
          );
          if (!context.mounted) return false;
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(
              content: Text("기록이 삭제되었습니다!", style: TextStyle(color: Colors.black)),
              backgroundColor: Colors.amberAccent,
              duration: Duration(milliseconds: 1000),
            ),
          );
          return true;
        }
        return false;
      },
      background: Container(
        alignment: Alignment.centerRight,
        padding: const EdgeInsets.only(right: 20),
        color: Colors.red,
        child: const Icon(Icons.delete, color: Colors.white),
      ),
      child: GestureDetector(
        onTap: () => _openRecordEditor(
          context,
          initialContent: record['content'],
          isEditing: true,
          record: record,
        ),
        child: Container(
          width: double.infinity,
          margin: const EdgeInsets.only(bottom: 12),
          padding: const EdgeInsets.all(12),
          decoration: BoxDecoration(
            color: Colors.white10,
            borderRadius: BorderRadius.circular(8),
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                _formatDateTime(record['savedAt'] ?? DateTime.now().toString()),
                style: const TextStyle(color: Colors.white60, fontFamily: 'kopub', fontSize: 12),
              ),
              const SizedBox(height: 6),
              Text(
                record['content'] ?? '',
                style: const TextStyle(
                  color: Colors.white,
                  fontFamily: 'kopub',
                  fontWeight: FontWeight.w500,
                  fontSize: 16,
                  letterSpacing: 1,
                ),
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
              ),
            ],
          ),
        ),
      ),
    );
  }

  String _formatDateTime(String date) {
    try {
      final parsed = DateTime.parse(date);
      return DateFormat('yy/MM/dd HH:mm').format(parsed);
    } catch (_) {
      return date;
    }
  }

  void _openRecordEditor(BuildContext context,
      {String? initialContent, bool isEditing = false, Map<String, dynamic>? record}) {
    final provider = Provider.of<SavedBooksProvider>(context, listen: false);
    final controller = TextEditingController(text: initialContent ?? "");

    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.white,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(20)),
      ),
      builder: (context) => Padding(
        padding: MediaQuery.of(context).viewInsets,
        child: Container(
          height: MediaQuery.of(context).size.height * 0.75,
          padding: const EdgeInsets.all(20),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Text(
                    DateFormat('yy.MM.dd HH:mm').format(DateTime.now()),
                    style: const TextStyle(fontSize: 16, fontFamily: 'kopub', fontWeight: FontWeight.bold),
                  ),
                  Row(
                    children: [
                      if (isEditing)
                        IconButton(
                          icon: const Icon(Icons.delete, color: Colors.redAccent),
                          onPressed: () async {
                            Navigator.pop(context);
                            await _deleteRecord(context, record!);
                          },
                        ),
                      IconButton(
                        icon: const Icon(Icons.check, color: Color(0xFF0A1D27)),
                        onPressed: () async {
                          final newContent = controller.text.trim();
                          if (newContent.isEmpty) return;

                          if (isEditing && record != null) {
                            await provider.updateRecordByContent(
                                book.id,
                                record['savedAt'],
                                record['content'],
                                newContent);
                            if (!context.mounted) return;
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text("기록이 수정되었습니다!", style: TextStyle(color: Colors.black, fontSize: 16)),
                                backgroundColor: Colors.amberAccent,
                              ),
                            );
                          } else {
                            await provider.addRecord(book.id, newContent);
                            if (!context.mounted) return;
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text("기록이 추가되었습니다!", style: TextStyle(color: Colors.black, fontSize: 16)),
                                backgroundColor: Colors.amberAccent,
                              ),
                            );
                          }
                          Navigator.pop(context);
                        },
                      ),
                    ],
                  )
                ],
              ),
              const SizedBox(height: 10),
              Expanded(
                child: TextField(
                  controller: controller,
                  autofocus: true,
                  maxLines: null,
                  style: const TextStyle(fontSize: 18, fontFamily: 'kopub'),
                  decoration: const InputDecoration(
                    hintText: "기록을 작성해보세요...",
                    border: InputBorder.none,
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Future<void> _deleteRecord(BuildContext context, Map<String, dynamic> record) async {
    final confirm = await showDialog<bool>(
      context: context,
      builder: (_) => AlertDialog(
        title: const Text("기록 삭제", style: TextStyle(fontFamily: 'kopub', fontWeight: FontWeight.bold)),
        content: const Text("이 기록을 삭제할까요?", style: TextStyle(fontFamily: 'kopub', fontSize: 16)),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(true),
            child: const Text("삭제", style: TextStyle(color: Colors.redAccent)),
          ),
          TextButton(
            onPressed: () => Navigator.of(context).pop(false),
            child: const Text("취소"),
          ),
        ],
      ),
    );

    if (confirm == true) {
      final provider = Provider.of<SavedBooksProvider>(context, listen: false);
      await provider.deleteRecord(book.id, record['savedAt'], record['content']);
      if (!context.mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text("기록이 삭제되었습니다!", style: TextStyle(color: Colors.black)),
          backgroundColor: Colors.amberAccent,
        ),
      );
    }
  }

  /// 책 삭제
  void _confirmDeleteBook(BuildContext context) async {
    final confirm = await showDialog<bool>(
      context: context,
      builder: (_) => AlertDialog(
        title: const Text("책 삭제",
            style: TextStyle(fontFamily: 'kopub', fontWeight: FontWeight.bold)),
        content: const Text("정말 이 책을 삭제할까요? \n책과 관련된 모든 기록이 사라져요!",
            style: TextStyle(fontFamily: 'kopub', fontSize: 16)),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(true),
            child: const Text("삭제", style: TextStyle(color: Colors.redAccent)),
          ),
          TextButton(
            onPressed: () => Navigator.of(context).pop(false),
            child: const Text("취소"),
          ),
        ],
      ),
    );

    if (confirm == true) {
      final savedProvider = Provider.of<SavedBooksProvider>(context, listen: false);
      final libProvider = Provider.of<CustomLibraryProvider>(context, listen: false);
      savedProvider.removeBook(book.id, libProvider);
      Navigator.pop(context);
    }
  }

}
