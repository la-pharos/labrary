class ChallengeOngoingScreen extends StatefulWidget {
  final Challenge challenge;

  const ChallengeOngoingScreen({super.key, required this.challenge});

  @override
  State<ChallengeOngoingScreen> createState() => _ChallengeOngoingScreenState();
}

class _ChallengeOngoingScreenState extends State<ChallengeOngoingScreen> {
  Map<String, dynamic> recordData = {};
  DateTime? routineStart;
  int routineDays = 0;
  bool isEditing = false;
  late DateTime today;
  late DateTime currentMonth;
  bool showDetails = false;
  final TextEditingController searchController = TextEditingController();
  List<Map<String, String>> searchResults = [];
  List<Map<String, String>> selectedBooks = [];
  Map<String, dynamic> _routineChecks = {};
  late List<Map<String, String>> editedBooks;

  bool isSameDate(DateTime a, DateTime b) {
    return a.year == b.year && a.month == b.month && a.day == b.day;
  }

  @override
  void initState() {
    super.initState();
    final now = DateTime.now().toLocal();
    today = DateTime(now.year, now.month, now.day);
    currentMonth = DateTime(today.year, today.month);
    editedBooks = List<Map<String, String>>.from(widget.challenge.participatingBooks ?? []);
    _loadRecord();
  }

  Future<void> _loadRecord() async {
    final data = await ChallengeRecordService.fetchChallengeRecord(widget.challenge.id);
    _routineChecks = Map<String, dynamic>.from(data['routineChecks'] ?? {});

    if (widget.challenge.kind == ChallengeKind.routine) {
      final start = data["routineStartDate"];
      final end = data["routineEndDate"];
      if (start != null && end != null) {
        routineStart = DateTime.tryParse(start)?.toLocal();
        routineDays = DateTime.tryParse(end)?.toLocal()?.difference(routineStart!)?.inDays ?? 0 + 1;
      }
    }

    final progress = ChallengeProgressUtils.getProgressFromRecord(widget.challenge, data);
    final endDate = widget.challenge.endDate?.toLocal();
    final isPastEndDate = endDate != null && DateTime.now().isAfter(endDate);
    final hasAnyRoutineCheck = (data['routineChecks'] ?? {}).values.any((v) => v == true);
    final shouldMarkCompleted = (progress >= 1.0 || isPastEndDate) && hasAnyRoutineCheck && !widget.challenge.isCompleted;

    if (shouldMarkCompleted && mounted) {
      final provider = Provider.of<ChallengeProvider>(context, listen: false);
      provider.markChallengeAsCompleted(widget.challenge);
      provider.updateChallenge(widget.challenge);
      await Future.delayed(const Duration(milliseconds: 100));
      _showCompletionDialog();
    }
  }

  void _showCompletionDialog() {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (_) {
        Future.delayed(const Duration(milliseconds: 1500), () {
          if (mounted) {
            Navigator.pop(context);
            Navigator.of(context).pushAndRemoveUntil(
              MaterialPageRoute(builder: (context) => const ChallengeScreen()),
                  (route) => false,
            );
          }
        });
        return AlertDialog(
          backgroundColor: Colors.greenAccent,
          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
          content: Row(
            children: [
              const Icon(Icons.emoji_events, color: Colors.deepPurple, size: 36),
              const SizedBox(width: 10),
              Expanded(
                child: Text(
                  "🎉 축하합니다! 🎉 \n'${widget.challenge.title}' 챌린지를 \n달성했습니다!",
                  style: const TextStyle(
                    color: Colors.black,
                    fontFamily: 'kopub',
                    fontWeight: FontWeight.bold,
                    fontSize: 18,
                  ),
                ),
              ),
            ],
          ),
        );
      },
    );
  }

  void onSearchChanged(String keyword) {
    setState(() {
      searchResults = dummyBooks.where((book) {
        final title = book['title']?.toLowerCase() ?? '';
        final author = book['author']?.toLowerCase() ?? '';
        return title.contains(keyword.toLowerCase()) || author.contains(keyword.toLowerCase());
      }).toList();
    });
  }

  void onBookSelected(Map<String, String> book) {
    final bookId = generateBookId(book['isbn'] ?? '', book['title'] ?? '', book['author'] ?? '');
    final savedBooksProvider = Provider.of<SavedBooksProvider>(context, listen: false);
    final now = widget.challenge.startDate ?? DateTime.now();
    final alreadyExists = widget.challenge.participatingBooks!
        .any((b) => generateBookId(b['isbn'] ?? '', b['title'] ?? '', b['author'] ?? '') == bookId);

    if (!alreadyExists) {
      final bookWithMeta = {
        'title': book['title'] ?? '',
        'author': book['author'] ?? '',
        'imageUrl': book['imageUrl'] ?? '',
        'isbn': book['isbn'] ?? '',
        'id': bookId,
        'category': 'reading',
        'startDate': now.toString(),
        'endDate': '',
      };

      savedBooksProvider.addBook(bookWithMeta);
      setState(() {
        widget.challenge.participatingBooks!.add(bookWithMeta);
      });
    }

    setState(() {
      searchResults = [];
      searchController.clear();
    });
  }

  void onBookRemoved(Map<String, String> book) {
    setState(() {
      widget.challenge.participatingBooks?.remove(book);
    });
  }

  void _goToPreviousMonth() {
    setState(() {
      currentMonth = DateTime(currentMonth.year, currentMonth.month - 1);
    });
  }

  void _goToNextMonth() {
    setState(() {
      currentMonth = DateTime(currentMonth.year, currentMonth.month + 1);
    });
  }

  ///
  ///
  ///

  @override
  Widget build(BuildContext context) {
    final challenge = widget.challenge;
    final savedBooks = Provider.of<SavedBooksProvider>(context).savedBooks;
    final isRoutine = challenge.kind == ChallengeKind.routine;
    final today = DateTime.now().toLocal();

    final progress = isRoutine
        ? ChallengeProgressUtils.getProgressFromRecord(challenge, recordData)
        : ChallengeProgressUtils.getProgress(challenge, savedBooks);

    final completed = isRoutine
        ? ChallengeProgressUtils.getCompletedCountFromRecord(challenge, recordData)
        : ChallengeProgressUtils.getCompletedCount(challenge, recordData);

    final total = isRoutine
        ? ChallengeProgressUtils.getTargetCountFromRecord(challenge, recordData)
        : ChallengeProgressUtils.getTargetCount(challenge);

    int remaining = 0;
    if (isRoutine && routineStart != null && routineDays > 0) {
      remaining = routineStart!.add(Duration(days: routineDays)).difference(today).inDays;
    } else if (challenge.endDate != null) {
      remaining = challenge.endDate!.toLocal().difference(today).inDays + 1;
    }

    return Scaffold(
      backgroundColor: const Color(0xFF013328),
      appBar: AppBar(
        backgroundColor: Colors.transparent,
        elevation: 0,
        leading: IconButton(
          icon: const Icon(Icons.arrow_back, color: Colors.white),
          onPressed: () {
            Navigator.of(context).pushAndRemoveUntil(
              MaterialPageRoute(builder: (_) => const ChallengeScreen()),
                  (route) => false,
            );
          },
        ),
        title: Text(
          challenge.title,
          style: const TextStyle(color: Colors.white, fontFamily: 'kopub'),
        ),
        actions: [
          if (challenge.isCustom)
            IconButton(
              icon: const Icon(Icons.edit, color: Colors.white),
              onPressed: () {
                Navigator.push(
                  context,
                  MaterialPageRoute(builder: (_) => ChallengeEditScreen(challenge: challenge)),
                );
              },
            )
        ],
      ),
      body: Stack(
        children: [
          SingleChildScrollView(
            padding: const EdgeInsets.all(20),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                _buildImage(challenge.imageUrl),
                const SizedBox(height: 20),
                const Divider(color: Colors.white24),
                const SizedBox(height: 10),
                Text(
                  challenge.title,
                  style: const TextStyle(
                    color: Colors.white,
                    fontFamily: 'kopub',
                    fontSize: 24,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                const SizedBox(height: 16),
                _buildProgressCard(progress, completed, total, remaining),
                const SizedBox(height: 20),
                _buildRecordSection(challenge, recordData, savedBooks),
                const SizedBox(height: 16),
                if (challenge.type != ChallengeType.specificBooks &&
                    challenge.participatingBooks != null) ...[
                  _buildParticipatingBooksSection(challenge.participatingBooks!),
                  const SizedBox(height: 16),
                ],
                const Divider(color: Colors.white24),
                const SizedBox(height: 16),
                _buildSummaryCard(challenge),
                const SizedBox(height: 10),
                Align(
                  alignment: Alignment.centerLeft,
                  child: TextButton.icon(
                    style: TextButton.styleFrom(
                      padding: EdgeInsets.zero, // ✅ 패딩 제거
                      tapTargetSize: MaterialTapTargetSize.shrinkWrap,
                    ),
                    onPressed: () {
                      setState(() {
                        showDetails = !showDetails;
                      });
                    },
                    icon: Text( // ✅ 텍스트 먼저
                      showDetails ? "챌린지 상세내용 접기" : "📂 챌린지 상세보기",
                      style: const TextStyle(
                        color: Colors.white,
                        fontFamily: 'kopub',
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    label: Icon( // ✅ 아이콘 나중
                      showDetails ? Icons.expand_less : Icons.expand_more,
                      color: Colors.white,
                    ),
                  ),
                ),
                AnimatedCrossFade(
                  duration: const Duration(milliseconds: 300),
                  crossFadeState: showDetails ? CrossFadeState.showFirst : CrossFadeState.showSecond,
                  firstChild: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      if (challenge.longDescription?.isNotEmpty == true)
                        _buildDescriptionSection("📖 챌린지 소개", challenge.longDescription!),
                      if (challenge.goalDescription?.isNotEmpty == true)
                        _buildDescriptionSection("🎯 도전 목표", challenge.goalDescription!),
                      if (challenge.recommendedFor?.isNotEmpty == true)
                        _buildDescriptionSection("🙋 이런 분께 추천", challenge.recommendedFor!),
                      if (challenge.guideText?.isNotEmpty == true)
                        _buildDescriptionSection("📌 진행 방법", challenge.guideText!),
                    ],
                  ),
                  secondChild: const SizedBox.shrink(),
                ),
                const SizedBox(height: 100),
              ],
            ),
          ),

          Align(
            alignment: Alignment.bottomCenter,
            child: Padding(
              padding: const EdgeInsets.only(bottom: 40.0),
              child: SizedBox(
                width: MediaQuery.of(context).size.width * 0.9,
                child: ElevatedButton(
                  onPressed: () => showGiveUpDialog(context),
                  style: ElevatedButton.styleFrom(
                    backgroundColor: Colors.redAccent,
                    padding: const EdgeInsets.symmetric(vertical: 18),
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
                  ),
                  child: const Text(
                    "챌린지 포기하기",
                    style: TextStyle(
                      fontSize: 18,
                      fontFamily: 'kopub',
