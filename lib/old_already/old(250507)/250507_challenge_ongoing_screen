      ),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(title,
                    style: const TextStyle(
                        color: Colors.white,
                        fontSize: 18,
                        fontWeight: FontWeight.bold,
                        fontFamily: 'kopub')),
                const SizedBox(height: 6),
                Text(content,
                    style: const TextStyle(
                        color: Colors.white70,
                        fontSize: 15,
                        height: 1.4,
                        fontFamily: 'kopub')),
              ],
            ),
          ),
        ],
      ),
    );
  }


  Widget _buildParticipatingBooksSection(List<Map<String, String>> books) {
    final savedBooksProvider = Provider.of<SavedBooksProvider>(context, listen: false);
    final savedBooks = savedBooksProvider.savedBooks;

    Future<void> _openBookSearchDialog() async {
      final selectedBook = await showDialog<Map<String, String>>(
        context: context,
        builder: (_) => BookSearchDialog(
          onBookSelected: (book) => Navigator.of(context).pop(book),
        ),
      );

      if (selectedBook != null) {
        final bookId = generateBookId(
          selectedBook['isbn'] ?? '',
          selectedBook['title'] ?? '',
          selectedBook['author'] ?? '',
        );

        final alreadyExists = editedBooks.any((b) =>
        generateBookId(b['isbn'] ?? '', b['title'] ?? '', b['author'] ?? '') ==
            bookId);

        if (!alreadyExists) {
          // ⚠️ 모든 필드를 String으로 처리
          final newBook = {
            'title': selectedBook['title'] ?? '',
            'author': selectedBook['author'] ?? '',
            'imageUrl': selectedBook['imageUrl'] ?? '',
            'isbn': selectedBook['isbn'] ?? '',
            'id': bookId,
            'category': 'reading',
            'startDate': DateTime.now().toIso8601String(),
            'endDate': '',
          };

          Provider.of<SavedBooksProvider>(context, listen: false)
              .addBook(Map<String, dynamic>.from(newBook));

          setState(() {
            editedBooks.add(Map<String, String>.from(newBook));
            widget.challenge.participatingBooks?.add(Map<String, String>.from(newBook));
          });
        }
      }
    }

    Future<void> _confirmChanges() async {
      final confirmed = await showDialog<bool>(
        context: context,
        builder: (context) => AlertDialog(
          backgroundColor: const Color(0xFF1B2C2E),
          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
          title: const Text("해당 내용으로 저장할까요?",
              style: TextStyle(fontFamily: 'kopub', fontWeight: FontWeight.bold, fontSize: 18, color: Colors.white)),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(context, false),
              child: const Text("취소", style: TextStyle(color: Colors.white70)),
            ),
            TextButton(
              onPressed: () => Navigator.pop(context, true),
              child: const Text("확인", style: TextStyle(color: Colors.amberAccent, fontWeight: FontWeight.bold)),
            ),
          ],
        ),
      );

      if (confirmed == true) {
        // ✅ Challenge 객체 업데이트
        final updatedChallenge = widget.challenge.copyWith(
          participatingBooks: List<Map<String, String>>.from(editedBooks),
        );

        // ✅ Provider 호출
        Provider.of<ChallengeProvider>(context, listen: false)
            .updateChallenge(updatedChallenge);

        setState(() {
          widget.challenge.participatingBooks!
            ..clear()
            ..addAll(editedBooks);
          isEditing = false;
        });
      }
    }

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            const Text("🔸 선택한 책 목록",
                style: TextStyle(color: Colors.white, fontSize: 16,fontFamily: 'Kopub', letterSpacing: 1.1)),
            TextButton(
              onPressed: () async {
                if (isEditing) {
                  await _confirmChanges();
                } else {
                  setState(() => isEditing = true);
                }
              },
              child: Text(isEditing ? "완료" : "편집",
                  style: const TextStyle(color: Colors.amberAccent, fontSize: 14, fontFamily: 'Kopub', fontWeight: FontWeight.bold)),
            ),
          ],
        ),
        const SizedBox(height: 10),
        Wrap(
          spacing: 10,
          runSpacing: 10,
          children: [
            ...editedBooks.map((book) => Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                Stack(
                  children: [
                    ClipRRect(
                      borderRadius: BorderRadius.circular(8),
                      child: Image.network(
                        book['imageUrl'] ?? '',
                        width: 70,
                        height: 100,
                        fit: BoxFit.cover,
                        errorBuilder: (_, __, ___) => Container(
                          width: 70,
                          height: 100,
                          color: Colors.grey,
                          child: const Icon(Icons.book, color: Colors.white),
                        ),
                      ),
                    ),
                    if (isEditing)
                      Positioned(
                        top: 0,
                        right: 0,
                        child: GestureDetector(
                          onTap: () {
                            final bookId = generateBookId(
                              book['isbn'] ?? '',
                              book['title'] ?? '',
                              book['author'] ?? '',
                            );
                            final savedBooksProvider = Provider.of<SavedBooksProvider>(context, listen: false);
                            final customLibraryProvider = Provider.of<CustomLibraryProvider>(context, listen: false);

                            savedBooksProvider.removeBook(bookId, customLibraryProvider); // ✅ 수정 완료

                            setState(() {
                              editedBooks.removeWhere((b) =>
                              generateBookId(b['isbn'] ?? '', b['title'] ?? '', b['author'] ?? '') == bookId);
                            });
                          },
                          child: const CircleAvatar(
                            radius: 12,
                            backgroundColor: Colors.redAccent,
                            child: Icon(Icons.close, size: 14, color: Colors.white),
                          ),
                        ),
                      )
                  ],
                ),
                const SizedBox(height: 4),
                SizedBox(
                  width: 70,
                  child: Text(
                    book['title'] ?? '',
                    style: const TextStyle(color: Colors.white70, fontSize: 12,fontWeight: FontWeight.bold),
                    overflow: TextOverflow.ellipsis,
                    maxLines: 2,
                    textAlign: TextAlign.center,
                  ),
                )
              ],
            )),
            if (isEditing)
              GestureDetector(
                onTap: _openBookSearchDialog,
                child: Container(
                  width: 70,
                  height: 100,
                  decoration: BoxDecoration(
                    color: Colors.white10,
                    borderRadius: BorderRadius.circular(8),
                  ),
                  child: const Center(
                    child: Icon(Icons.add, color: Colors.white54, size: 30),
                  ),
                ),
              ),
          ],
        ),
      ],
    );
  }



  /// 챌린지 포기하기 버튼 다이얼로그
  Future<void> showGiveUpDialog(BuildContext context) async {
    final confirmed = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        backgroundColor: const Color(0xFF1B2C2E),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
        title: const Text(
          "정말 포기하시겠어요?",
          style: TextStyle(
            fontFamily: 'kopub',
            fontWeight: FontWeight.bold,
            fontSize: 18,
            color: Colors.white,
          ),
        ),
        content: const Text(
          "지금까지의 챌린지 기록이 모두 삭제됩니다.\n그래도 포기하시겠어요?",
          style: TextStyle(
            fontFamily: 'kopub',
            fontSize: 15,
            height: 1.4,
            color: Colors.white70,
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            child: const Text(
              "계속 도전할래요",
              style: TextStyle(
                fontFamily: 'kopub',
                fontWeight: FontWeight.bold,
                color: Colors.amberAccent,
              ),
            ),
          ),
          TextButton(
            onPressed: () => Navigator.pop(context, true),
            child: const Text(
              "네, 포기할게요",
              style: TextStyle(
                fontFamily: 'kopub',
                fontWeight: FontWeight.bold,
                color: Colors.redAccent,
              ),
            ),
          ),
        ],
      ),
    );

    if (confirmed == true && context.mounted) {
      final provider = Provider.of<ChallengeProvider>(context, listen: false);
      await provider.unjoinChallenge(widget.challenge);
      if (context.mounted) {
        Navigator.of(context).pushAndRemoveUntil(
          MaterialPageRoute(builder: (_) => const ChallengeScreen()),
              (route) => false,
        );
      }
    }
  }
