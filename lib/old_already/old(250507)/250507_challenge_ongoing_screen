  Widget _buildProgressCard(double progress, int completed, int total, int remainingDays) {
    final isRoutine = widget.challenge.kind == ChallengeKind.routine;
    final unit = isRoutine ? "일" : "권";
    final percentage = (progress * 100).toInt();

    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: Colors.white10,
        borderRadius: BorderRadius.circular(12),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          if (remainingDays > 0)
            Text(
              "⏳ 종료까지 D-$remainingDays",
              style: const TextStyle(
                color: Colors.amberAccent,
                fontSize: 16,
                fontWeight: FontWeight.bold,
                fontFamily: 'kopub',
              ),
            )
          else if (remainingDays == 0)
            const Text(
              "⏳ 오늘이 마지막 날이에요!",
              style: TextStyle(
                color: Colors.amberAccent,
                fontSize: 16,
                fontWeight: FontWeight.bold,
                fontFamily: 'kopub',
              ),
            ),
          const SizedBox(height: 10),
          LinearProgressIndicator(
            value: progress,
            backgroundColor: Colors.white24,
            valueColor: const AlwaysStoppedAnimation<Color>(Colors.amberAccent),
            minHeight: 8,
          ),
          const SizedBox(height: 12),
          Text(
            "$percentage% 완료  ($completed / $total $unit)",
            style: const TextStyle(
              color: Colors.white,
              fontFamily: 'kopub',
              fontSize: 15,
            ),
          ),
        ],
      ),
    );
  }

