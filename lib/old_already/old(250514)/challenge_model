import 'package:flutter/material.dart';
import 'package:uuid/uuid.dart';
import 'series_model.dart'; // 시리즈 모델 따로 관리
import 'package:dayverse_book/model/challenge_attempt_model.dart';


// ✅ 챌린지 종류
enum ChallengeKind {
  routine,   // 루틴 챌린지 (습관)
  goal,      // 정복 챌린지 (성취)
  theme,     // 테마 챌린지 (확장)
}

// ✅ 챌린지 유형
enum ChallengeType {
  amountBased,     // 총 권수 기준
  timeBased,       // 시간 기반
  specificBooks,   // 지정 도서 기반
}

// ✅ 챌린지 체크 방식
enum ChallengeCheckType {
  manual, // 사용자 자율 체크 (루틴)
  auto,   // 서재 연동 자동 체크 (정복/테마)
}

// ✅ 루틴형 챌린지 종류
enum RoutineCheckMode {
  daily,        // 매일 체크 (기존 방식)
  conditional,  // 조건 충족 시 횟수 체크 (새 방식)
}

// ✅ 챌린지 도전 방식
enum ChallengeAttemptMode {
  periodBased,  // 시작일 ~ 종료일 도전
  daysBased,    // 내가 정한 시작일부터 n일 도전
  countBased,   // n회 달성 도전
}

class Challenge {
  final String id;
  final String title;
  final String shortDescription;
  final String? longDescription;
  final String? goalDescription;
  final String? recommendedFor;
  final String? guideText;

  final ChallengeKind kind;
  final ChallengeType type;
  final ChallengeCheckType checkType;
  final RoutineCheckMode routineCheckMode;

  final List<int>? availableDurations;
  final int? defaultDurationDays;
  final DateTime? startDate;
  final DateTime? endDate;

  final int? totalBooks;
  final List<Map<String, dynamic>>? requiredBooks;
  final List<Map<String, String>>? participatingBooks;
  final List<Series>? seriesList;

  final String imageUrl;
  final String badgeImage;
  final String rewardTitle;

  final bool isSeries;
  final int? currentSeriesIndex;
  final String? nextChallengeId;

  bool isCustom;
  bool isPremium;
  bool isJoined;
  bool isCompleted;

  final bool isRepeatable;
  final List<ChallengeAttempt> attempts;

  final List<int>? targetCheckCountOptions;
  final int? defaultTargetCheckCount;

  Challenge({
    String? id,
    required this.title,
    required this.shortDescription,
    this.longDescription,
    this.goalDescription,
    this.recommendedFor,
    this.guideText,
    required this.kind,
    required this.type,
    required this.checkType,
    this.availableDurations,
    this.defaultDurationDays,
    this.startDate,
    this.endDate,
    this.totalBooks,
    this.requiredBooks,
    this.seriesList,
    this.participatingBooks,
    required this.imageUrl,
    required this.badgeImage,
    required this.rewardTitle,
    this.isSeries = false,
    this.currentSeriesIndex,
    this.nextChallengeId,
    this.isCustom = false,
    this.isPremium = false,
    this.isJoined = false,
    this.isCompleted = false,
    this.isRepeatable = false,
    this.attempts = const [],
    this.routineCheckMode = RoutineCheckMode.daily,
    this.targetCheckCountOptions,
    this.defaultTargetCheckCount,
  }) : id = id ?? const Uuid().v4();

  String get challengeDuration {
    if (startDate != null && endDate != null) {
      return "${endDate!.difference(startDate!).inDays + 1}일";
    }
    if (defaultDurationDays != null) {
      return "${defaultDurationDays}일 도전";
    }
    return "기간 미정";
  }

  int get successCount => attempts.where((a) => a.isSuccessful).length;
  ChallengeAttempt? get latestAttempt => attempts.isNotEmpty ? attempts.last : null;

  factory Challenge.fromMap(Map<String, dynamic> map) {
    return Challenge(
      id: map['id'],
      title: map['title'],
      shortDescription: map['shortDescription'] ?? '',
      longDescription: map['longDescription'],
      goalDescription: map['goalDescription'],
      recommendedFor: map['recommendedFor'],
      guideText: map['guideText'],
      kind: ChallengeKind.values.firstWhere((e) => e.name == map['kind']),
      type: ChallengeType.values.firstWhere((e) => e.name == map['type']),
      checkType: ChallengeCheckType.values.firstWhere((e) => e.name == map['checkType']),
      availableDurations: map['availableDurations'] != null
          ? List<int>.from(map['availableDurations'])
          : null,
      defaultDurationDays: map['defaultDurationDays'],
      startDate: map['startDate'] != null ? DateTime.parse(map['startDate']).toLocal() : null,
      endDate: map['endDate'] != null ? DateTime.parse(map['endDate']).toLocal() : null,
      totalBooks: map['totalBooks'],
      requiredBooks: map['requiredBooks'] != null
          ? List<Map<String, dynamic>>.from(map['requiredBooks'])
          : [],
      participatingBooks: map['participatingBooks'] != null
          ? List<Map<String, String>>.from(
          (map['participatingBooks'] as List).map((b) => Map<String, String>.from(b)))
          : [],
      seriesList: map['seriesList'] != null
          ? List<Series>.from(
          (map['seriesList'] as List).map((e) => Series.fromMap(Map<String, dynamic>.from(e))))
          : null,
      imageUrl: map['imageUrl'],
      badgeImage: map['badgeImage'],
      rewardTitle: map['rewardTitle'],
      isSeries: map['isSeries'] ?? false,
      currentSeriesIndex: map['currentSeriesIndex'],
      nextChallengeId: map['nextChallengeId'],
      isCustom: map['isCustom'] ?? false,
      isPremium: map['isPremium'] ?? false,
      isJoined: map['isJoined'] ?? false,
      isCompleted: map['isCompleted'] ?? false,
      isRepeatable: map['isRepeatable'] ?? false,
      attempts: map['attempts'] != null
          ? List<ChallengeAttempt>.from(
          (map['attempts'] as List).map((a) => ChallengeAttempt.fromMap(Map<String, dynamic>.from(a))))
          : [],
      routineCheckMode: map['routineCheckMode'] != null
          ? RoutineCheckMode.values.firstWhere((e) => e.name == map['routineCheckMode'])
          : RoutineCheckMode.daily,
      targetCheckCountOptions: map['targetCheckCountOptions'] != null
          ? List<int>.from(map['targetCheckCountOptions'])
          : null,
      defaultTargetCheckCount: map['defaultTargetCheckCount'],
    );

  }

  Map<String, dynamic> toMap() => {
    'id': id,
    'title': title,
    'shortDescription': shortDescription,
    'longDescription': longDescription,
    'goalDescription': goalDescription,
    'recommendedFor': recommendedFor,
    'guideText': guideText,
    'kind': kind.name,
    'type': type.name,
    'checkType': checkType.name,
    'availableDurations': availableDurations,
    'defaultDurationDays': defaultDurationDays,
    'startDate': startDate?.toIso8601String(),
    'endDate': endDate?.toIso8601String(),
    'totalBooks': totalBooks,
    'requiredBooks': requiredBooks ?? [],
    'participatingBooks': participatingBooks ?? [],
    'seriesList': seriesList?.map((e) => e.toMap()).toList(),
    'imageUrl': imageUrl,
    'badgeImage': badgeImage,
    'rewardTitle': rewardTitle,
    'isSeries': isSeries,
    'currentSeriesIndex': currentSeriesIndex,
    'nextChallengeId': nextChallengeId,
    'isCustom': isCustom,
    'isPremium': isPremium,
    'isJoined': isJoined,
    'isCompleted': isCompleted,
    'isRepeatable': isRepeatable,
    'attempts': attempts.map((e) => e.toMap()).toList(),
    'routineCheckMode': routineCheckMode.name,
    'targetCheckCountOptions': targetCheckCountOptions,
    'defaultTargetCheckCount': defaultTargetCheckCount,
  };

  Challenge copyWith({
    String? title,
    String? shortDescription,
    String? longDescription,
    String? goalDescription,
    String? recommendedFor,
    String? guideText,
    ChallengeKind? kind,
    ChallengeType? type,
    ChallengeCheckType? checkType,
    List<int>? availableDurations,
    int? defaultDurationDays,
    DateTime? startDate,
    DateTime? endDate,
    int? totalBooks,
    List<Map<String, dynamic>>? requiredBooks,
    List<Map<String, String>>? participatingBooks,
    List<Series>? seriesList,
    String? imageUrl,
    String? badgeImage,
    String? rewardTitle,
    bool? isSeries,
    int? currentSeriesIndex,
    String? nextChallengeId,
    bool? isCustom,
    bool? isPremium,
    bool? isJoined,
    bool? isCompleted,
    bool? isRepeatable,
    List<ChallengeAttempt>? attempts,
    RoutineCheckMode? routineCheckMode,
    List<int>? targetCheckCountOptions,
    int? defaultTargetCheckCount,
  }) {
    return Challenge(
      id: id,
      title: title ?? this.title,
      shortDescription: shortDescription ?? this.shortDescription,
      longDescription: longDescription ?? this.longDescription,
      goalDescription: goalDescription ?? this.goalDescription,
      recommendedFor: recommendedFor ?? this.recommendedFor,
      guideText: guideText ?? this.guideText,
      kind: kind ?? this.kind,
      type: type ?? this.type,
      checkType: checkType ?? this.checkType,
      availableDurations: availableDurations ?? this.availableDurations,
      defaultDurationDays: defaultDurationDays ?? this.defaultDurationDays,
      startDate: startDate ?? this.startDate,
      endDate: endDate ?? this.endDate,
      totalBooks: totalBooks ?? this.totalBooks,
      requiredBooks: requiredBooks ?? this.requiredBooks,
      participatingBooks: participatingBooks ?? this.participatingBooks,
      seriesList: seriesList ?? this.seriesList,
      imageUrl: imageUrl ?? this.imageUrl,
      badgeImage: badgeImage ?? this.badgeImage,
      rewardTitle: rewardTitle ?? this.rewardTitle,
      isSeries: isSeries ?? this.isSeries,
      currentSeriesIndex: currentSeriesIndex ?? this.currentSeriesIndex,
      nextChallengeId: nextChallengeId ?? this.nextChallengeId,
      isCustom: isCustom ?? this.isCustom,
      isPremium: isPremium ?? this.isPremium,
      isJoined: isJoined ?? this.isJoined,
      isCompleted: isCompleted ?? this.isCompleted,
      isRepeatable: isRepeatable ?? this.isRepeatable,
      attempts: attempts ?? this.attempts,
      routineCheckMode: routineCheckMode ?? this.routineCheckMode,
      targetCheckCountOptions: targetCheckCountOptions ?? this.targetCheckCountOptions,
      defaultTargetCheckCount: defaultTargetCheckCount ?? this.defaultTargetCheckCount,
    );
  }

  Challenge copyWithAddedAttempt(ChallengeAttempt attempt) {
    return copyWith(attempts: [...attempts, attempt]);
  }
}
