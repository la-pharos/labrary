    Widget _buildParticipatingBooksSection(List<Map<String, String>> books) {
      final savedBooksProvider = Provider.of<SavedBooksProvider>(context, listen: false);
      final customLibraryProvider = Provider.of<CustomLibraryProvider>(context, listen: false);

      Future<void> _openBookSearchDialog() async {
        final selectedBook = await showDialog<Map<String, String>>(
          context: context,
          builder: (_) => BookSearchDialog(onBookSelected: (book) => Navigator.of(context).pop(book)),
        );

        if (selectedBook != null) {
          final bookId = generateBookId(
            selectedBook['isbn'] ?? '',
            selectedBook['title'] ?? '',
            selectedBook['author'] ?? '',
          );

          final alreadyExists = editedBooks.any((b) =>
          generateBookId(b['isbn'] ?? '', b['title'] ?? '', b['author'] ?? '') == bookId);

          if (!alreadyExists) {
            final newBook = {
              'title': selectedBook['title'] ?? '',
              'author': selectedBook['author'] ?? '',
              'imageUrl': selectedBook['imageUrl'] ?? '',
              'isbn': selectedBook['isbn'] ?? '',
              'id': bookId,
              'category': 'reading',
              'startDate': DateTime.now().toIso8601String(),
              'endDate': '',
            };

            savedBooksProvider.addBook(Map<String, dynamic>.from(newBook));

            setState(() {
              editedBooks.add(Map<String, String>.from(newBook));
              widget.challenge.participatingBooks?.add(Map<String, String>.from(newBook));
            });
          }
        }
      }

      Future<void> _confirmChanges() async {
        final confirmed = await showDialog<bool>(
          context: context,
          builder: (_) => AlertDialog(
            backgroundColor: const Color(0xFF1B2C2E),
            shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
            title: const Text("해당 내용으로 저장할까요?",
                style: TextStyle(fontFamily: 'kopub', fontWeight: FontWeight.bold, fontSize: 18, color: Colors.white)),
            actions: [
              TextButton(onPressed: () => Navigator.pop(context, false), child: const Text("취소", style: TextStyle(color: Colors.white70))),
              TextButton(onPressed: () => Navigator.pop(context, true), child: const Text("확인", style: TextStyle(color: Colors.amberAccent))),
            ],
          ),
        );

        if (confirmed == true) {
          final updatedChallenge = widget.challenge.copyWith(
            participatingBooks: List<Map<String, String>>.from(editedBooks),
          );

          Provider.of<ChallengeProvider>(context, listen: false).updateChallenge(updatedChallenge);

          setState(() {
            widget.challenge.participatingBooks!
              ..clear()
              ..addAll(editedBooks);
            isEditing = false;
          });
        }
      }

      Widget _buildBookItem(Map<String, String> book) {
        final bookId = generateBookId(book['isbn'] ?? '', book['title'] ?? '', book['author'] ?? '');

        return Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Stack(
              children: [
                ClipRRect(
                  borderRadius: BorderRadius.circular(8),
                  child: Image.network(
                    book['imageUrl'] ?? '',
                    width: 70,
                    height: 100,
                    fit: BoxFit.cover,
                    alignment: Alignment.bottomCenter ,
                    errorBuilder: (_, __, ___) => Container(
                      width: 70,
                      height: 100,
                      color: Colors.grey,
                      child: const Icon(Icons.book, color: Colors.white),
                    ),
                  ),
                ),
                if (isEditing)
                  Positioned(
                    top: 0,
                    right: 0,
                    child: GestureDetector(
                      onTap: () {
                        savedBooksProvider.removeBook(bookId, customLibraryProvider);
                        setState(() {
                          editedBooks.removeWhere((b) =>
                          generateBookId(b['isbn'] ?? '', b['title'] ?? '', b['author'] ?? '') == bookId);
                        });
                      },
                      child: const CircleAvatar(
                        radius: 12,
                        backgroundColor: Colors.redAccent,
                        child: Icon(Icons.close, size: 14, color: Colors.white),
                      ),
                    ),
                  )
              ],
            ),
            const SizedBox(height: 4),
            SizedBox(
              width: 70,
              child: Text(
                book['title'] ?? '',
                style: const TextStyle(color: Colors.white70, fontSize: 12, fontWeight: FontWeight.bold),
                overflow: TextOverflow.ellipsis,
                maxLines: 2,
                textAlign: TextAlign.center,
              ),
            )
          ],
        );
      }

      return Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              const Text("🔸 선택한 책 목록", style: TextStyle(color: Colors.white, fontSize: 16, fontFamily: 'Kopub')),
              TextButton(
                onPressed: () async {
                  if (isEditing) {
                    await _confirmChanges();
                  } else {
                    setState(() => isEditing = true);
                  }
                },
                child: Text(isEditing ? "완료" : "편집",
                    style: const TextStyle(color: Colors.amberAccent, fontSize: 14, fontFamily: 'Kopub', fontWeight: FontWeight.bold)),
              ),
            ],
          ),
          const SizedBox(height: 10),
          Wrap(
            spacing: 10,
            runSpacing: 10,
            children: [
              ...editedBooks.map(_buildBookItem),
              if (isEditing)
                GestureDetector(
                  onTap: _openBookSearchDialog,
                  child: Container(
                    width: 70,
                    height: 100,
                    decoration: BoxDecoration(color: Colors.white10, borderRadius: BorderRadius.circular(8)),
                    child: const Center(child: Icon(Icons.add, color: Colors.white54, size: 30)),
                  ),
                ),
            ],
          ),
        ],
      );
    }
