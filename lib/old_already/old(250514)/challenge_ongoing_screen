    _loadRecord();
  }

  Future<void> _loadRecord() async {
    final data = await ChallengeRecordService.fetchChallengeRecord(widget.challenge.id);
    print("[LOAD] fetched record data: $data");

    final checks = Map<String, dynamic>.from(data['routineChecks'] ?? {});
    recordData['routineChecks'] = checks;

    // ✅ 핵심 수정: 일관된 목표 수 계산
    final targetDaysOrCount = ChallengeProgressUtils.getTargetCount(widget.challenge, data);

    DateTime? start;
    DateTime? end;

    if (widget.challenge.kind == ChallengeKind.routine) {
      final startStr = data["routineStartDate"];
      final endStr = data["routineEndDate"];
      start = DateTime.tryParse(startStr ?? '')?.toLocal();
      end = DateTime.tryParse(endStr ?? '')?.toLocal();
    }

    final calculatedProgress = ChallengeProgressUtils.getProgress(widget.challenge, data);
    final completedCount = checks.values.where((v) => v == true).length;

    final today = DateTime.now().toLocal();
    final todayDateOnly = DateTime(today.year, today.month, today.day);
    final startDateOnly = start != null ? DateTime(start.year, start.month, start.day) : null;

    int elapsedDays = 0;
    int remainingDays = 0;

    if (startDateOnly != null && targetDaysOrCount > 0) {
      elapsedDays = todayDateOnly.difference(startDateOnly).inDays;
      if (elapsedDays < 0) elapsedDays = 0;
      if (elapsedDays >= targetDaysOrCount) {
        remainingDays = 0;
      } else {
        remainingDays = targetDaysOrCount - elapsedDays;
      }
    }

    setState(() {
      _routineChecks = checks;
      routineStart = start;
      routineDays = targetDaysOrCount;  // ✅ 수정 적용

      progress = calculatedProgress;
      completed = completedCount;
      total = targetDaysOrCount;        // ✅ 수정 적용
      this.remainingDays = remainingDays;
    });

    print("[LOAD] routineStart: $routineStart");
    print("[LOAD] routineDays: $routineDays");
    print("[LOAD] progress result: $progress");
    print("[LOAD] completed: $completed");
    print("[LOAD] total: $total");
    print("[LOAD] remainingDays: $remainingDays");

    final isPastEndDate = end != null && todayDateOnly.isAfter(DateTime(end.year, end.month, end.day));
    final hasAnyRoutineCheck = checks.values.any((v) => v == true);
    final shouldMarkCompleted = (calculatedProgress >= 1.0 || isPastEndDate) &&
        hasAnyRoutineCheck &&
        !widget.challenge.isCompleted;

    if (shouldMarkCompleted && mounted) {
      print("[LOAD] challenge should be marked as completed");
      final provider = Provider.of<ChallengeProvider>(context, listen: false);
      final updated = provider.markChallengeAsCompleted(widget.challenge);

      await Future.delayed(const Duration(milliseconds: 100));
      _showCompletionDialog(updated);
    }
  }

  void _showCompletionDialog(Challenge updatedChallenge) {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (_) {
        Future.delayed(const Duration(milliseconds: 1500), () {
          if (mounted) {
            Navigator.pop(context);
            Navigator.of(context).pushAndRemoveUntil(
              MaterialPageRoute(
                builder: (context) => const MainScreen(initialTabIndex: 2), // ✅ 네비게이션 유지
