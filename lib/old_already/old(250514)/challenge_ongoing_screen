            setState(() {
              _routineChecks[dateKey] = !isChecked;
              recordData['routineChecks'] = _routineChecks;
            });
            if (!isChecked) {
              await showDialog(
                context: context,
                barrierDismissible: false,
                builder: (_) {
                  Future.delayed(const Duration(milliseconds: 1500), () {
                    if (context.mounted) Navigator.pop(context);
                  });
                  return AlertDialog(
                    backgroundColor: Colors.greenAccent,
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                    content: IntrinsicWidth(
                      child: Column(
                        mainAxisSize: MainAxisSize.min,
                        children: const [
                          Text("🎉✨", style: TextStyle(fontSize: 36)),
                          SizedBox(height: 12),
                          Text("오늘의 루틴 완료!\n꾸준함이 빛을 만듭니다 💪", textAlign: TextAlign.center),
                          SizedBox(height: 8),
                          Text("응원합니다 🌟", textAlign: TextAlign.center),
                        ],
                      ),
                    ),
                  );
                },
              );
              await _loadRecord();
            }
            await Provider.of<ChallengeProvider>(context, listen: false).refreshChallengeStatus(challenge.id);
          } : null,
          child: Container(
            margin: const EdgeInsets.all(4),
            width: 44,
            height: 44,
            alignment: Alignment.center,
            decoration: BoxDecoration(
              color: isChecked ? const Color(0xFF00FF88).withOpacity(0.7) : Colors.white10,
              border: isToday ? Border.all(color: Colors.amberAccent, width: 2) : null,
              borderRadius: BorderRadius.circular(6),
            ),
            child: isInMonth
                ? (isChecked
                ? const Icon(Icons.check, color: Colors.black, size: 20)
                : Text(
              "${date.day}",
              style: TextStyle(
                color: isAfterOrSameAsStart ? Colors.white70 : Colors.white30,
                fontFamily: 'kopub',
              ),
            ))
                : const SizedBox.shrink(),
          ),
        );
      }

      List<Widget> _buildCalendarGrid() {
        final List<Widget> rows = [];
        final firstWeekday = startOfMonth.weekday % 7;
        int dayCounter = 1 - firstWeekday;

        for (int week = 0; week < 6; week++) {
          List<Widget> days = [];
          for (int weekday = 0; weekday < 7; weekday++) {
            final date = DateTime.utc(currentMonth.year, currentMonth.month, 1).add(Duration(days: dayCounter - 1)).add(const Duration(hours: 9));
            days.add(_buildCalendarDayCell(date));
            dayCounter++;
          }
          rows.add(Row(mainAxisAlignment: MainAxisAlignment.center, children: days));
        }
        return rows;
      }

      return Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const SizedBox(height: 12),
          const Text("🔸 이번 달 루틴 체크", style: TextStyle(color: Colors.white, fontSize: 16, fontFamily: 'Kopub')),
          const SizedBox(height: 12),
          Center(child: const Text("오늘 날짜를 클릭하면 자동 체크돼요!", style: TextStyle(color: Colors.white70, fontSize: 12, fontFamily: 'Kopub'))),
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              IconButton(icon: const Icon(Icons.chevron_left, color: Colors.white), onPressed: () => setState(() => currentMonth = DateTime(currentMonth.year, currentMonth.month - 1))),
              Text("${currentMonth.year}년 ${currentMonth.month}월", style: const TextStyle(color: Colors.white, fontSize: 16, fontFamily: 'kopub', fontWeight: FontWeight.bold)),
              IconButton(icon: const Icon(Icons.chevron_right, color: Colors.white), onPressed: () => setState(() => currentMonth = DateTime(currentMonth.year, currentMonth.month + 1))),
            ],
          ),
          const SizedBox(height: 12),
          ..._buildCalendarGrid(),
        ],
      );
    }

    Widget _buildSpecificBookSection(Challenge challenge, List<Map<String, dynamic>> savedBooks) {
      final requiredBooks = challenge.requiredBooks ?? [];

      final readBookIds = savedBooks
          .where((book) => book["category"] == "done")
          .map((book) => book["id"])
          .toSet();

      return Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Text(
            "🔸 읽어야 할 지정도서 목록",
            style: TextStyle(
              color: Colors.white,
              fontSize: 16,
              fontFamily: 'Kopub',
            ),
          ),
          const SizedBox(height: 12),
          ...requiredBooks.map((book) {
            final id = book["id"];
            final title = book["title"] ?? "제목 없음";
            final author = book["author"] ?? "저자 없음";
            final isRead = readBookIds.contains(id);

            return Container(
              margin: const EdgeInsets.only(bottom: 8),
              padding: const EdgeInsets.symmetric(vertical: 10, horizontal: 12),
              decoration: BoxDecoration(
                color: isRead ? Colors.green.withOpacity(0.2) : Colors.white10,
                borderRadius: BorderRadius.circular(8),
              ),
              child: Row(
                children: [
                  Icon(
                    isRead ? Icons.check_circle : Icons.radio_button_unchecked,
                    color: isRead ? Colors.greenAccent : Colors.white38,
                  ),
                  const SizedBox(width: 10),
                  Expanded(
                    child: Text(
                      "$title ($author)",
                      style: const TextStyle(
                        color: Colors.white,
                        fontFamily: 'kopub',
                        fontSize: 15,
                      ),
                    ),
                  ),
                ],
              ),
            );
          }).toList(),
        ],
      );
    }
  Widget _buildSummaryCard(Challenge challenge) {
      final typeText = _getChallengeTypeText(challenge.kind);
      final isConditionalRoutine = challenge.kind == ChallengeKind.routine && challenge.routineCheckMode == RoutineCheckMode.conditional;
      final isDailyRoutine = challenge.kind == ChallengeKind.routine && challenge.routineCheckMode == RoutineCheckMode.daily;

      final durationText = (challenge.availableDurations?.isNotEmpty ?? false)
          ? challenge.availableDurations!.map((d) => "$d일").join(" / ")
          : "기간 미정";

      final targetCheckCountText = (challenge.targetCheckCountOptions?.isNotEmpty ?? false)
          ? challenge.targetCheckCountOptions!.map((c) => "$c회").join(" / ")
          : "횟수 미정";

      return Column(
        children: [
          _buildInfoCard("💡 한줄 소개", challenge.shortDescription ?? "-"),
          _buildInfoCard("📂 챌린지 유형", typeText),
          if (isDailyRoutine)
            _buildInfoCard("🗓 도전 기간", durationText),
          if (isConditionalRoutine)
            _buildInfoCard("🗓 도전 횟수", targetCheckCountText),
          _buildInfoCard("🏅 리워드", challenge.rewardTitle),
        ],
      );
    }

    String _getChallengeTypeText(ChallengeKind kind) {
      switch (kind) {
        case ChallengeKind.routine:
          return "루틴 챌린지";
        case ChallengeKind.goal:
          return "정복 챌린지";
        case ChallengeKind.theme:
          return "테마 챌린지";
      }
    }

