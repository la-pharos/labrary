  Widget _buildProgressCard(Map<String, dynamic> recordData, List<Map<String, dynamic>> savedBooks) {
      final challenge = widget.challenge;
      final isRoutine = challenge.kind == ChallengeKind.routine;
      final isConditionalRoutine = isRoutine && challenge.routineCheckMode == RoutineCheckMode.conditional;
      final unit = isRoutine ? "일" : "권";

      final now = DateTime.now().toLocal();
      final today = DateTime(now.year, now.month, now.day);
      final startDate = challenge.startDate?.toLocal();

      final targetDaysOrCount = ChallengeProgressUtils.getTargetCount(challenge, recordData);

      int remainingDays = 0;
      if (isRoutine && startDate != null && targetDaysOrCount > 0) {
        final calculatedEnd = startDate.add(Duration(days: targetDaysOrCount - 1));
        remainingDays = calculatedEnd.difference(today).inDays;
        if (remainingDays < 0) remainingDays = 0;
      }

      final dynamic progressData = isRoutine ? recordData : savedBooks;
      final progress = ChallengeProgressUtils.getProgress(challenge, progressData);
      final completed = ChallengeProgressUtils.getCompletedCount(challenge, progressData);
      final total = targetDaysOrCount;
      final percentage = (progress * 100).toInt();

      if (isRoutine && startDate != null && today.isBefore(startDate)) {
        final dDay = startDate.difference(today).inDays;
        return _buildBeforeStartCard(dDay);
      }

      return Container(
        padding: const EdgeInsets.all(16),
        decoration: BoxDecoration(
          color: Colors.white10,
          borderRadius: BorderRadius.circular(12),
        ),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            if (isConditionalRoutine)
              const Text("☑️ 언제든지 조건이 충족되면 체크해보세요!",
                  style: TextStyle(
                    color: Colors.amberAccent,
                    fontSize: 16,
                    fontWeight: FontWeight.bold,
                    fontFamily: 'kopub',
                  ))
            else if (remainingDays > 0)
              Text("⏳ 종료까지 D-$remainingDays",
                  style: const TextStyle(
                    color: Colors.amberAccent,
                    fontSize: 16,
                    fontWeight: FontWeight.bold,
                    fontFamily: 'kopub',
                  ))
            else if (remainingDays == 0)
                const Text("⏳ 오늘이 마지막 날이에요!",
                    style: TextStyle(
                      color: Colors.amberAccent,
                      fontSize: 16,
                      fontWeight: FontWeight.bold,
                      fontFamily: 'kopub',
                    )),
            const SizedBox(height: 10),
            LinearProgressIndicator(
              value: progress,
              backgroundColor: Colors.white24,
              valueColor: const AlwaysStoppedAnimation<Color>(Colors.amberAccent),
              minHeight: 8,
            ),
            const SizedBox(height: 12),
            Text(
              (total > 0)
                  ? "$percentage% 완료  ($completed / $total $unit)"
                  : "도전 준비 중...",
              style: const TextStyle(
                color: Colors.white,
                fontFamily: 'kopub',
                fontSize: 15,
              ),
            )
          ],
        ),
      );
    }

