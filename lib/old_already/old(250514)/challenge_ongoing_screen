  Widget _buildRecordSection(Challenge challenge, Map<String, dynamic> recordData, List<Map<String, dynamic>> savedBooks) {
      if (challenge.kind == ChallengeKind.routine) {
        if (challenge.routineCheckMode == RoutineCheckMode.daily) {
          return _buildDailyRoutineCalendar(challenge, recordData);
        } else {
          return _buildConditionalRoutineCalendar(challenge, recordData);
        }
      }

      if (challenge.type == ChallengeType.specificBooks) {
        return _buildSpecificBookSection(challenge, savedBooks);
      }

      return Container(
        padding: const EdgeInsets.all(16),
        decoration: BoxDecoration(color: Colors.white10, borderRadius: BorderRadius.circular(12)),
        child: const Text("[기록 유형 없음]", style: TextStyle(color: Colors.white)),
      );
    }

    Widget _buildDailyRoutineCalendar(Challenge challenge, Map<String, dynamic> recordData) {
      final checks = _routineChecks;
      final startOfMonth = DateTime(currentMonth.year, currentMonth.month, 1);

      Widget _buildCalendarDayCell(DateTime date) {
        final dateKey = "${date.year}-${date.month.toString().padLeft(2, '0')}-${date.day.toString().padLeft(2, '0')}";
        final isChecked = checks[dateKey] == true;

        final today = DateTime.now().toLocal();
        final todayOnly = DateTime(today.year, today.month, today.day);
        final dateOnly = DateTime(date.year, date.month, date.day);
        final startOnly = routineStart != null ? DateTime(routineStart!.year, routineStart!.month, routineStart!.day) : null;
        final endOnly = startOnly != null && routineDays > 0 ? startOnly.add(Duration(days: routineDays - 1)) : null;

        final isInRange = startOnly != null && endOnly != null && !dateOnly.isBefore(startOnly) && !dateOnly.isAfter(endOnly);
        final isTodayAndInRange = dateOnly == todayOnly && isInRange;
        final isInMonth = date.month == currentMonth.month;

        return GestureDetector(
          onTap: (isInMonth && isTodayAndInRange) ? () async {
            await ChallengeRecordService.saveRoutineCheck(challenge.id, date, !isChecked);
            await Future.delayed(const Duration(milliseconds: 500));
            setState(() {
              _routineChecks[dateKey] = !isChecked;
              recordData['routineChecks'] = _routineChecks;
            });
            if (!isChecked) {
              await showDialog(
                context: context,
                barrierDismissible: false,
                builder: (_) {
                  Future.delayed(const Duration(milliseconds: 1500), () {
                    if (context.mounted) Navigator.pop(context);
                  });
                  return AlertDialog(
                    backgroundColor: Colors.greenAccent,
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                    content: IntrinsicWidth(
                      child: Column(
                        mainAxisSize: MainAxisSize.min,
                        children: const [
                          Text("🎉✨", style: TextStyle(fontSize: 36)),
                          SizedBox(height: 12),
                          Text("오늘의 루틴 완료!\n꾸준함이 빛을 만듭니다 💪", style: TextStyle(fontFamily: 'Kopub'), textAlign: TextAlign.center),
                          SizedBox(height: 8),
                          Text("응원합니다 🌟", style: TextStyle(fontFamily: 'Kopub'), textAlign: TextAlign.center),
                        ],
                      ),
                    ),
                  );
                },
              );
              await _loadRecord();
            }
            await Provider.of<ChallengeProvider>(context, listen: false).refreshChallengeStatus(challenge.id);
          } : null,
          child: Container(
            margin: const EdgeInsets.all(4),
            width: 44,
            height: 44,
            alignment: Alignment.center,
            decoration: BoxDecoration(
              color: isChecked ? const Color(0xFF00FF88).withOpacity(0.7) : Colors.white10,
              border: isTodayAndInRange ? Border.all(color: Colors.amberAccent, width: 2) : null,
              borderRadius: BorderRadius.circular(6),
            ),
            child: isInMonth
                ? (isChecked
                ? const Icon(Icons.check, color: Colors.black, size: 20)
                : Text(
              "${date.day}",
              style: TextStyle(
                color: isInRange ? Colors.white70 : Colors.white30,
                fontFamily: 'kopub',
              ),
            ))
                : const SizedBox.shrink(),
          ),
        );
      }

      List<Widget> _buildCalendarGrid() {
        final List<Widget> rows = [];
        final firstWeekday = startOfMonth.weekday % 7;
        int dayCounter = 1 - firstWeekday;

        for (int week = 0; week < 6; week++) {
          List<Widget> days = [];
          for (int weekday = 0; weekday < 7; weekday++) {
            final date = DateTime.utc(currentMonth.year, currentMonth.month, 1).add(Duration(days: dayCounter - 1)).add(const Duration(hours: 9));
            days.add(_buildCalendarDayCell(date));
            dayCounter++;
          }
          rows.add(Row(mainAxisAlignment: MainAxisAlignment.center, children: days));
        }
        return rows;
      }

      return Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const SizedBox(height: 12),
          const Text("🔸 이번 달 루틴 체크", style: TextStyle(color: Colors.white, fontSize: 16, fontFamily: 'Kopub')),
          const SizedBox(height: 12),
          Center(child: const Text("오늘 날짜를 클릭하면 자동 체크돼요!", style: TextStyle(color: Colors.white70, fontSize: 12, fontFamily: 'Kopub', fontWeight: FontWeight.bold))),
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              IconButton(icon: const Icon(Icons.chevron_left, color: Colors.white), onPressed: () => setState(() => currentMonth = DateTime(currentMonth.year, currentMonth.month - 1))),
              Text("${currentMonth.year}년 ${currentMonth.month}월", style: const TextStyle(color: Colors.white, fontSize: 16, fontFamily: 'kopub', fontWeight: FontWeight.bold)),
              IconButton(icon: const Icon(Icons.chevron_right, color: Colors.white), onPressed: () => setState(() => currentMonth = DateTime(currentMonth.year, currentMonth.month + 1))),
            ],
          ),
          const SizedBox(height: 12),
          ..._buildCalendarGrid(),
        ],
      );
    }

