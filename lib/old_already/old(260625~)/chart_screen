                fontWeight: FontWeight.bold,
                color: Colors.white,
              ),
            ),
          ],
        ),
        SizedBox(height: screenWidth * 0.04),
        if (completedChallenges.isEmpty)
          _buildChallengeLikePlaceholderBox(
            context,
            screenWidth,
          )
        else
          Column(
            children: completedChallenges.map<Widget>((challenge) {
              return ChallengeCard(
                challenge: challenge,
                showAttemptsBadge: true,
                stageChipDisplayMode: StageChipDisplayMode.completed,
                onTap: () {
                  Navigator.push(
                    context,
                    MaterialPageRoute(
                      builder: (_) =>
                          ChallengeDoneScreen(challenge: challenge),
                    ),
                  );
                },
              );
            }).toList(),
          ),
      ],
    );
  }

