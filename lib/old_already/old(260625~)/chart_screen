  /// 독서 메
  Widget _buildNoteSection(BuildContext context) {
    final screenWidth = MediaQuery.of(context).size.width;
    final screenHeight = MediaQuery.of(context).size.height;

    final savedBooksProvider = context.watch<SavedBooksProvider>();

    final allNotes = savedBooksProvider.bookRecords
        .where((record) => record['content'] != '독서 타이머 기록')
        .toList();

    allNotes.sort((a, b) {
      final dateA = a['date'];
      final dateB = b['date'];

      if (dateA == null && dateB == null) return 0;
      if (dateA == null) return 1;
      if (dateB == null) return -1;

      return dateB.compareTo(dateA);
    });

    final int totalNotes = allNotes.length;
    final Map<String, dynamic>? latestNote =
    allNotes.isNotEmpty ? allNotes.first : null;

    final book = latestNote != null
        ? savedBooksProvider.getBookById(
      latestNote['bookId']?.toString() ?? '',
    )
        : null;

    final String latestContent =
        latestNote?['content']?.toString().trim() ?? '';

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          children: [
            Expanded(
              child: Text(
                '독서 메모',
                style: TextStyle(
                  fontSize: screenWidth * 0.04,
                  fontFamily: 'kopub',
                  fontWeight: FontWeight.bold,
                  color: Colors.white,
                ),
              ),
            ),
          ],
        ),

        SizedBox(height: screenWidth * 0.04),

        CardBox(
          onTap: () {
            Navigator.push(
              context,
              MaterialPageRoute(
                builder: (_) => const MemoScreen(),
              ),
            );
          },

          // 빈 상태는 현재 크기 유지,
          // 메모가 있으면 내부 여백을 조금 더 넓게
          padding: EdgeInsets.all(
            totalNotes == 0
                ? screenWidth * 0.025
                : screenWidth * 0.04,
          ),

          child: totalNotes == 0
              ? _buildEmptyNoteCard(
            screenWidth,
            screenHeight,
          )
              : _buildLatestNoteCard(
            screenWidth: screenWidth,
            screenHeight: screenHeight,
            book: book,
            latestContent: latestContent,
            totalNotes: totalNotes,
          ),
        ),
      ],
    );
  }

