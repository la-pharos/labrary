  const BookDetailScreen({super.key, required this.book});

  @override
  State<BookDetailScreen> createState() => _BookDetailScreenState();
}

class _BookDetailScreenState extends State<BookDetailScreen> {
  String? startDate;
  String? endDate;
  bool _showTimerRecords = false;
  List<Map<String, dynamic>> _timerLogs = [];


  @override
  void initState() {
    super.initState();
    _loadTimerLogs();
  }
  Future<void> _loadTimerLogs() async {
    final logs = await ReadingLogService.getTimerLogsForBook(widget.book.id);
    if (mounted) setState(() => _timerLogs = logs);
  }

  @override
  Widget build(BuildContext context) {
    final records = context.watch<SavedBooksProvider>().getRecordsForBook(widget.book.id);

    return GestureDetector(
      onHorizontalDragUpdate: (details) {
        if (details.delta.dx > 20) Navigator.pop(context);
      },
