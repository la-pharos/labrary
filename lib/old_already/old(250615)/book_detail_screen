  Future<void> _deleteRecord(Map<String, dynamic> record) async {
    final confirm = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text("기록 삭제", style: TextStyle(fontFamily: 'kopub', fontWeight: FontWeight.bold)),
        content: const Text("이 기록을 삭제할까요?", style: TextStyle(fontFamily: 'kopub',fontSize: 16)),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(true),
            child: const Text("삭제", style: TextStyle(color: Colors.redAccent)),
          ),
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(false),
            child: const Text("취소"),
          ),
        ],
      ),
    );

    if (confirm == true) {
      final provider = Provider.of<SavedBooksProvider>(context, listen: false);
      await provider.deleteRecord(widget.book.id, record['savedAt'], record['content']);
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text("기록이 삭제되었습니다!", style: TextStyle(color: Colors.black)),
          backgroundColor: Colors.amberAccent,
        ),
      );
    }
  }

  void _changeCategory() {
    showModalBottomSheet(
      context: context,
      builder: (BuildContext context) {
        return Container(
          padding: const EdgeInsets.all(20),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              ListTile(
                title: const Text("읽은 책", style: TextStyle(fontFamily: 'kopub')),
                onTap: () async {
                  final start = await _pickDate(true);
                  final end = await _pickDate(false);
                  _updateCategory("done", startDateStr: start, endDateStr: end);
                },
              ),
              ListTile(
                title: const Text("읽는 중인 책", style: TextStyle(fontFamily: 'kopub')),
                onTap: () async {
                  final start = await _pickDate(true);
                  _updateCategory("reading", startDateStr: start);
                },
              ),
              ListTile(
                title: const Text("읽을 예정인 책", style: TextStyle(fontFamily: 'kopub')),
                onTap: () => _updateCategory("want"),
              ),
            ],
          ),
        );
      },
    );
  }

  void _updateCategory(String newCategory, {String? startDateStr, String? endDateStr}) {
    final provider = Provider.of<SavedBooksProvider>(context, listen: false);

    // 문자열로 받은 날짜를 DateTime으로 파싱 (null 처리)
    final startDate = (startDateStr != null && startDateStr.isNotEmpty) ? DateTime.tryParse(startDateStr) : null;
    final endDate = (endDateStr != null && endDateStr.isNotEmpty) ? DateTime.tryParse(endDateStr) : null;

    // 카테고리 업데이트
    provider.updateCategory(widget.book.id, newCategory);

    // 날짜 업데이트 (Provider 메서드를 사용)
    provider.updateBookDates(widget.book.id, startDate: startDate, endDate: endDate);

    Navigator.pop(context);
  }

  String _getCategoryDescription(String? category, String? start, String? end) {
    switch (category) {
      case "done":
        return "${_formatDisplayDate(start ?? '')} ~ ${_formatDisplayDate(end ?? '')} 까지 읽었어요!";
      case "reading":
        return "${_formatDisplayDate(start ?? '')} 부터 읽고 있어요!";
      case "want":
        return "곧 읽을 책이에요!";
      default:
        return "";
    }
  }

  String _formatDisplayDate(String date) {
    try {
      final parsed = DateTime.parse(date);
      return DateFormat('yy/MM/dd').format(parsed);
    } catch (_) {
      return date;
    }
  }

  Future<String?> _pickDate(bool isStartDate) async {
    DateTime now = DateTime.now();
    DateTime? pickedDate = await showDatePicker(
      context: context,
      initialDate: now,
      firstDate: DateTime(2000),
      lastDate: DateTime(2100),
    );

    if (pickedDate != null) {
      return DateFormat('yyyy-MM-dd').format(pickedDate);
    }
    return null;
  }

  // ✅ 서재 위치 파트
  void _openLibraryAssignDialog() {
    final customLibraryProvider =
    Provider.of<CustomLibraryProvider>(context, listen: false);
    final bookId = widget.book.id;
    final libraries = customLibraryProvider.libraries;

    // 서재가 없는 경우 안내
    if (libraries.isEmpty) {
      showDialog(
        context: context,
        builder: (_) => AlertDialog(
          backgroundColor: Colors.white,
          shape:
          RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
          title: const Text("등록된 서재가 없습니다",
              style: TextStyle(
                color: Color(0xFF0A1D27),
                fontFamily: 'kopub',
              )),
          content: const Text("서재에 추가하려면 먼저 서재를 생성해주세요!",
              style: TextStyle(
                color: Color(0xFF0A1D27),
                fontFamily: 'kopub',
              )),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(context),
              child: const Text("확인",
                  style: TextStyle(
                    color: Colors.amberAccent,
                    fontFamily: 'kopub',
                  )),
            ),
          ],
        ),
      );
      return;
    }

    //  다이얼로그 with 실시간 상태 업데이트
    showModalBottomSheet(
      context: context,
      backgroundColor: Colors.white,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(20)),
      ),
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setModalState) {
            return Padding(
              padding: const EdgeInsets.all(20),
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: libraries.keys.map((libraryName) {
                  final isInLibrary = libraries[libraryName]!.contains(bookId);
                  return CheckboxListTile(
                    title: Text(libraryName,
                        style: const TextStyle(
                          color: Color(0xFF0A1D27),
                          fontFamily: 'kopub',
                          fontWeight: FontWeight.bold,
                        )),
                    value: isInLibrary,
                    activeColor: Colors.amberAccent,
                    checkColor: Colors.black,
                    onChanged: (value) {
                      setModalState(() {
                        if (value == true) {
                          customLibraryProvider.addBookToLibrary(
                              libraryName, bookId);
                        } else {
                          customLibraryProvider.removeBookFromCustomLibrary(
                              libraryName, bookId);
                        }
                      });
                      setState(() {}); // 외부 상태도 동기화
                    },
                  );
                }).toList(),
              ),
            );
          },
        );
      },
    );
  }

  Widget _buildCurrentLibrariesInline() {
    final customLibraryProvider = Provider.of<CustomLibraryProvider>(context);
    final bookId = widget.book.id;
    final libraries = customLibraryProvider.libraries.entries
        .where((entry) => entry.value.contains(bookId))
        .map((entry) => entry.key)
        .toList();

    if (libraries.isEmpty) {
      return const Text(
        "아직 어떤 서재에도 속해있지 않아요.",
        style: TextStyle(color: Colors.white, fontSize: 16), //
        overflow: TextOverflow.ellipsis,
      );
    }
    return Wrap(
      spacing: 6,
      runSpacing: 4,
      children: libraries.map((name) {
        return Column(
          children: [
            SizedBox(height: 5),
            Container(
              padding: const EdgeInsets.symmetric(vertical: 4, horizontal: 10),
              decoration: BoxDecoration(
                color: Colors.white10,
                borderRadius: BorderRadius.circular(20),
              ),
              child: Text(
                name,
                style: const TextStyle(
                    color: Colors.white, fontFamily: 'kopub', fontSize: 16,),
              ),
            ),
          ],
        );
      }).toList(),
    );
  }

  void _confirmDeleteBook() async {
    final confirm = await showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text("책 삭제", style: TextStyle(fontFamily: 'Kopub', fontWeight: FontWeight.bold),),
        content: const Text("정말 이 책을 삭제할까요? \n책과 관련된 모든 기록이 사라져요!", style: TextStyle(fontFamily: 'Kopub', fontSize: 16),),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(true),
            child: const Text("삭제", style: TextStyle(color: Colors.redAccent)),
          ),
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(false),
            child: const Text("취소"),
          ),
        ],
      ),
    );

    if (confirm == true) {
      final bookId = widget.book.id;
      Provider.of<SavedBooksProvider>(context, listen: false)
          .removeBook(bookId, Provider.of<CustomLibraryProvider>(context, listen: false));
      Navigator.pop(context);
    }
  }

