  Widget _buildTimerRecordSection(List<Map<String, dynamic>> logs) {
    final totalMinutes = logs.fold<int>(
      0,
          (sum, r) => sum + ((r['durationMinutes'] ?? 0) as num).toInt(),
    );

    final int hours = totalMinutes ~/ 60;
    final int minutes = totalMinutes % 60;
    final totalTimeText = logs.isNotEmpty
        ? (hours > 0 ? "$hours시간 ${minutes}분 읽었어요!" : "$minutes분 읽었어요!")
        : "아직 읽지 않았어요.";

    return Container(
      decoration: BoxDecoration(
        color: const Color(0xFF0A1D27),
        borderRadius: BorderRadius.circular(8),
      ),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.center,
        children: [
          GestureDetector(
            onTap: () => _openTimerRecordViewer(logs),
            child: Container(
              width: 32,
              height: 32,
              decoration: BoxDecoration(
                color: const Color(0xFF0A1D27),
                borderRadius: BorderRadius.circular(6),
              ),
              child: const Icon(Icons.schedule, color: Colors.amberAccent, size: 25),
            ),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Text(
              totalTimeText,
              style: const TextStyle(
                fontSize: 16,
                fontFamily: "Kopub",
                fontWeight: FontWeight.w500,
                color: Colors.white,
              ),
            ),
          ),
        ],
      ),
    );
  }

  void _openTimerRecordViewer(List<Map<String, dynamic>> logs) {
    if (logs.isEmpty) {
      showDialog(
        context: context,
        builder: (ctx) => AlertDialog(
          title: const Text("기록이 비어 있어요 🌱", style: TextStyle(fontWeight: FontWeight.bold)),
          content: const Text("타이머를 사용해 첫 독서 기록을 남겨보세요!"),
          actions: [
            TextButton(
              onPressed: () => Navigator.of(ctx).pop(),
              child: const Text("좋아요!", style: TextStyle(color: Colors.amberAccent)),
            ),
          ],
        ),
      );
      return;
    }

    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.white,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(20)),
      ),
      builder: (context) => Padding(
        padding: MediaQuery.of(context).viewInsets,
        child: Container(
          padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 20),
          height: MediaQuery.of(context).size.height * 0.75,
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text(
                "독서 시간 기록",
                style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
              ),
              const SizedBox(height: 12),
              Expanded(
                child: ListView.builder(
                  itemCount: logs.length,
                  itemBuilder: (context, index) {
                    final record = logs[index];
                    final start = DateTime.tryParse(record['startTime'] ?? '');
                    final end = DateTime.tryParse(record['endTime'] ?? '');
                    final duration = record['durationMinutes'] ?? 0;
                    final recordId = record['recordId'];

                    final dateStr = start != null ? DateFormat('yy/MM/dd').format(start) : '';
                    final startStr = start != null ? DateFormat('HH:mm').format(start) : '';
                    final endStr = end != null ? DateFormat('HH:mm').format(end) : '';

                    return Dismissible(
                      key: Key(recordId ?? UniqueKey().toString()),
                      direction: DismissDirection.endToStart,
                      confirmDismiss: (_) async {
                        final confirm = await showDialog<bool>(
                          context: context,
                          builder: (ctx) => AlertDialog(
                            title: const Text("기록 삭제"),
                            content: const Text("이 독서 시간 기록을 삭제할까요?"),
                            actions: [
                              TextButton(
                                onPressed: () => Navigator.of(ctx).pop(true),
                                child: const Text("삭제", style: TextStyle(color: Colors.redAccent)),
                              ),
                              TextButton(
                                onPressed: () => Navigator.of(ctx).pop(false),
                                child: const Text("취소"),
                              ),
                            ],
                          ),
                        );

                        if (confirm == true && recordId != null) {
                          await ReadingLogService.deleteTimerLog(recordId);
                          await _loadTimerLogs(); // 갱신
                          return true;
                        }
                        return false;
                      },
                      background: Container(
                        alignment: Alignment.centerRight,
                        padding: const EdgeInsets.only(right: 20),
                        color: Colors.red,
                        child: const Icon(Icons.delete, color: Colors.white),
                      ),
                      child: Container(
                        margin: const EdgeInsets.only(bottom: 12),
                        padding: const EdgeInsets.all(12),
                        decoration: BoxDecoration(
                          color: Colors.grey.shade100,
                          borderRadius: BorderRadius.circular(10),
                        ),
                        child: Row(
                          mainAxisAlignment: MainAxisAlignment.spaceBetween,
                          children: [
                            Text(
                              "$dateStr ($startStr~$endStr)",
                              style: const TextStyle(fontSize: 14),
                            ),
                            Text(
                              "$duration분",
                              style: const TextStyle(
                                fontSize: 16,
                                fontWeight: FontWeight.bold,
                                color: Colors.deepOrange,
                              ),
                            ),
                          ],
                        ),
                      ),
                    );
                  },
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  String _getTotalReadingTimeStr() {
    final total = _timerLogs.fold<int>(
      0,
          (sum, r) => sum + ((r['durationMinutes'] ?? 0) as num).toInt(),
    );

    final hours = total ~/ 60;
    final minutes = total % 60;
    return hours > 0 ? "$hours시간 ${minutes}분 읽었어요!" : "$minutes분 읽었어요!";
  }

  Widget _buildMemoSection(List<Map<String, dynamic>> records) {
    final memos = records.where((r) => r['content'] != '독서 타이머 기록').toList();

    return Row(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        GestureDetector(
          onTap: () => _openRecordEditor(),
          child: Container(
            width: 32,
            height: 32,
            decoration: BoxDecoration(
              color: const Color(0xFF0A1D27),
              borderRadius: BorderRadius.circular(6),
            ),
            child: const Icon(Icons.edit_note_outlined, size: 25, color: Colors.amberAccent),
          ),
        ),
        const SizedBox(width: 12),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              if (memos.isEmpty)
                Container(
                  height: 32,
                  alignment: Alignment.centerLeft,
                  child: GestureDetector(
                    onTap: () => _openRecordEditor(),
                    child: const Text(
                      "아이콘을 눌러 기록을 남겨보세요.",
                      style: TextStyle(color: Colors.white, fontSize: 16),
                      overflow: TextOverflow.ellipsis,
                    ),
                  ),
                ),
              if (memos.isNotEmpty)
                ...memos.map((record) => _buildMemoItem(record)).toList(),
            ],
          ),
        ),
      ],
    );
  }

  Widget _buildMemoItem(Map<String, dynamic> record) {
    return Dismissible(
      key: UniqueKey(),
      direction: DismissDirection.endToStart,
      confirmDismiss: (direction) async {
        final confirm = await showDialog<bool>(
          context: context,
          builder: (ctx) => AlertDialog(
            title: const Text("기록 삭제", style: TextStyle(fontFamily: 'kopub', fontWeight: FontWeight.bold)),
            content: const Text("이 기록을 삭제할까요?", style: TextStyle(fontFamily: 'kopub', fontSize: 16)),
            actions: [
              TextButton(
                onPressed: () => Navigator.of(ctx).pop(true),
                child: const Text("삭제", style: TextStyle(color: Colors.redAccent)),
              ),
              TextButton(
                onPressed: () => Navigator.of(ctx).pop(false),
                child: const Text("취소"),
              ),
            ],
          ),
        );

        if (confirm == true) {
          final provider = Provider.of<SavedBooksProvider>(context, listen: false);
          await provider.deleteRecord(widget.book.id, record['savedAt'], record['content']);
          if (context.mounted) {
            ScaffoldMessenger.of(context).showSnackBar(
              const SnackBar(
                content: Text("기록이 삭제되었습니다!", style: TextStyle(color: Colors.black)),
                backgroundColor: Colors.amberAccent,
                duration: Duration(milliseconds: 1000),
              ),
            );
          }
          return true;
        } else {
          return false;
        }
      },
      background: Container(
        alignment: Alignment.centerRight,
        padding: const EdgeInsets.only(right: 20),
        color: Colors.red,
        child: const Icon(Icons.delete, color: Colors.white),
      ),
      child: GestureDetector(
        onTap: () => _openRecordEditor(
          initialContent: record['content'],
          isEditing: true,
          record: record,
        ),
        child: Container(
          width: double.infinity,
          margin: const EdgeInsets.only(bottom: 12),
          padding: const EdgeInsets.all(12),
          decoration: BoxDecoration(
            color: Colors.white10,
            borderRadius: BorderRadius.circular(8),
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                _formatDateTime(record['savedAt'] ?? DateTime.now().toString()),
                style: const TextStyle(color: Colors.white60, fontFamily: 'kopub', fontSize: 12),
              ),
              const SizedBox(height: 6),
              Text(
                record['content'] ?? '',
                style: const TextStyle(color: Colors.white, fontFamily: 'kopub', fontWeight: FontWeight.w500, fontSize: 16, letterSpacing: 1),
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
              ),
            ],
          ),
        ),
      ),
    );
  }

  String _formatDateTime(String date) {
    try {
      final parsed = DateTime.parse(date);
      return DateFormat('yy/MM/dd HH:mm').format(parsed);
    } catch (_) {
      return date;
    }
  }

  void _openRecordEditor({String? initialContent, bool isEditing = false, Map<String, dynamic>? record}) {
    final provider = Provider.of<SavedBooksProvider>(context, listen: false);
    final controller = TextEditingController(text: initialContent ?? "");

    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.white,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(20)),
      ),
      builder: (context) => Padding(
        padding: MediaQuery.of(context).viewInsets,
        child: Container(
          height: MediaQuery.of(context).size.height * 0.75,
          padding: const EdgeInsets.all(20),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Text(
                    DateFormat('yy.MM.dd HH:mm').format(DateTime.now()),
                    style: const TextStyle(fontSize: 16, fontFamily: 'kopub', fontWeight: FontWeight.bold),
                  ),
                  Row(
                    children: [
                      if (isEditing)
                        IconButton(
                          icon: const Icon(Icons.delete, color: Colors.redAccent),
                          onPressed: () async {
                            Navigator.pop(context);
                            await _deleteRecord(record!);
                          },
                        ),
                      IconButton(
                        icon: const Icon(Icons.check, color: Color(0xFF0A1D27)),
                        onPressed: () async {
                          final newContent = controller.text.trim();
                          if (newContent.isEmpty) return;

                          if (isEditing && record != null) {
                            await provider.updateRecordByContent(widget.book.id, record['savedAt'], record['content'], newContent);
                            if (!mounted) return;
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text("기록이 수정되었습니다!", style: TextStyle(color: Colors.black, fontSize: 16)),
                                backgroundColor: Colors.amberAccent,
                              ),
                            );
                          } else {
                            await provider.addRecord(widget.book.id, newContent);
                            if (!mounted) return;
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text("기록이 추가되었습니다!", style: TextStyle(color: Colors.black, fontSize: 16)),
                                backgroundColor: Colors.amberAccent,
                              ),
                            );
                          }
                          Navigator.pop(context);
                        },
                      ),
                    ],
                  )
                ],
              ),
              const SizedBox(height: 10),
              Expanded(
                child: TextField(
                  controller: controller,
                  autofocus: true,
                  maxLines: null,
                  style: const TextStyle(fontSize: 18, fontFamily: 'kopub'),
                  decoration: const InputDecoration(
                    hintText: "기록을 작성해보세요...",
                    border: InputBorder.none,
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

