  Future<void> _handleCheckSuccess() async {
    final provider = Provider.of<ChallengeProvider>(context, listen: false);


    // 1. Firestore 상태 갱신 및 기록 로드
    await provider.refreshChallengeStatus(_currentChallenge.id);
    recordData = await ChallengeRecordService.fetchChallengeRecord(_currentChallenge.id);
    dailyMinutesMap = await ReadingLogService.getTotalReadingMinutesByDate();
    debugPrint("[🎯 _handleCheckSuccess → _loadRecord 호출]");
    await _loadRecord();

    // 2. 최신 챌린지 로드
    final updated = provider.findChallengeById(_currentChallenge.id);
    if (updated == null) {
      debugPrint("[❌ Challenge 로드 실패] ID: ${_currentChallenge.id}");
      return;
    }

    debugPrint("[📄 기존 attempts 갯수: ${updated.attempts.length}]");
    for (final a in updated.attempts) {
      debugPrint("→ start: ${a.startDate}, end: ${a.endDate}, success: ${a.isSuccessful}");
    }

    // ✅ 오늘 루틴 성공 다이얼로그
    if (context.mounted) {
      await showDialog(
        context: context,
        barrierDismissible: false,
        builder: (_) {
          Future.delayed(const Duration(milliseconds: 1500), () {
            if (context.mounted) Navigator.of(context).pop();
          });
          return _buildSuccessDialog();
        },
      );
    }

    await Future.delayed(const Duration(milliseconds: 300));

    // 3. 전체 챌린지 성공 여부 판단
    final checkAction = getChallengeCheckActionType(updated);
    final dynamic progressSource = checkAction == ChallengeCheckActionType.libraryAuto
        ? Provider.of<SavedBooksProvider>(context, listen: false).savedBooks
        : recordData ?? <String, dynamic>{};

    final isCompleted = ChallengeProgressUtils.isChallengeCompleted(updated, progressSource);
    debugPrint("[🔎 체크 완료 여부 판단 결과] isCompleted: $isCompleted");

    if (isCompleted) {
      final updatedChallenge = await provider.markChallengeAsCompleted(updated);
      debugPrint("[✅ markChallengeAsCompleted 처리 완료]");

      // ✅ 전체 챌린지 최신화
      await provider.refreshAllChallenges();

      // ✅ 축하 다이얼로그 및 완료 화면 이동
      if (context.mounted) {
        await showDialog(
          context: context,
          barrierDismissible: false,
          builder: (_) {
            Future.delayed(const Duration(milliseconds: 1500), () {
              if (context.mounted) Navigator.of(context).pop();
            });
            return _buildCompletionDialogContent(updatedChallenge);
          },
        );

        await Future.delayed(const Duration(milliseconds: 300));

        if (context.mounted) {
          Navigator.of(context).pushReplacement(
            MaterialPageRoute(builder: (_) => ChallengeDoneScreen(challenge: updatedChallenge)),
          );
        }
      }
    }
