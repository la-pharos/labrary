  /// ✅ 루틴 달력
  Widget buildRoutineProgressCalendar(Challenge challenge, Map<String, dynamic>? recordData) {
    final startOfMonth = DateTime(currentMonth.year, currentMonth.month, 1);

    final safeRecordData = recordData ?? {};
    final Map<String, dynamic> routineChecks =
        (safeRecordData['routineChecks'] as Map?)?.cast<String, dynamic>() ?? {};
    final Map<String, dynamic> rawMinutesMap =
        (safeRecordData['dailyMinutes'] as Map?)?.cast<String, dynamic>() ?? {};
    final dailyMinutesMap = rawMinutesMap.map((k, v) => MapEntry(k, (v as num).toInt()));

    final checkType = getChallengeCheckActionType(challenge);
    final requiredMinutes = challenge.requiredMinutes ?? 0;

    /// ✅ 현재 챌린지 시도(stage 포함)
    final attempt = challenge.attempts.isNotEmpty ? challenge.attempts.last : null;
    final stageIndex = attempt?.stageIndex ?? 0;
    final startDate = attempt?.startDate?.toLocal();
    final duration = attempt?.selectedDuration ?? 0;
    final endDate = (startDate != null && duration > 0)
        ? startDate.add(Duration(days: duration - 1))
        : null;

    Widget buildCalendarDayCell(DateTime date) {
      final dateKey = "${date.year}-${date.month.toString().padLeft(2, '0')}-${date.day.toString().padLeft(2, '0')}";
      final today = DateTime.now().toLocal();
      final dateOnly = DateTime(date.year, date.month, date.day);
      final todayOnly = DateTime(today.year, today.month, today.day);
      final isToday = dateOnly == todayOnly;

      final isInMonth = date.month == currentMonth.month;
      final isInRange = startDate != null && endDate != null &&
          !dateOnly.isBefore(startDate) &&
          !dateOnly.isAfter(endDate);

      bool isChecked = false;

      if (isInRange) {
        if (checkType == ChallengeCheckActionType.manual || checkType == ChallengeCheckActionType.pageAuto) {
          isChecked = routineChecks[dateKey] == true;
        } else if (checkType == ChallengeCheckActionType.timerAuto) {
          final minutes = dailyMinutesMap[dateKey] ?? 0;
          isChecked = minutes >= requiredMinutes;
        }
      }

      if (startDate != null && dateOnly.isBefore(startDate)) {
        isChecked = false; // 시작 전 무조건 체크 불가
      }
      if (dateOnly.isAfter(todayOnly)) {
        isChecked = false; // 미래 날짜 체크 불가
      }

      return Container(
        margin: const EdgeInsets.all(4),
        width: 44,
        height: 44,
        alignment: Alignment.center,
        decoration: BoxDecoration(
          color: isChecked
              ? const Color(0xFF00FF88).withOpacity(0.7)
              : Colors.white10,
          border: isToday ? Border.all(color: Colors.amberAccent, width: 2) : null,
          borderRadius: BorderRadius.circular(6),
        ),
        child: isInMonth
            ? (isChecked
            ? const Icon(Icons.check, color: Colors.black, size: 20)
            : Text(
          "${date.day}",
          style: TextStyle(
            color: isInRange ? Colors.white : Colors.white30,
            fontFamily: 'kopub',
          ),
        ))
            : const SizedBox.shrink(),
      );
    }

    List<Widget> buildCalendarGrid() {
      final List<Widget> rows = [];
      final firstWeekday = startOfMonth.weekday % 7;
      int dayCounter = 1 - firstWeekday;

      for (int week = 0; week < 6; week++) {
        List<Widget> days = [];
        for (int weekday = 0; weekday < 7; weekday++) {
          final date = DateTime.utc(currentMonth.year, currentMonth.month, 1)
              .add(Duration(days: dayCounter - 1))
              .add(const Duration(hours: 9)); // 한국 시간 보정
          days.add(buildCalendarDayCell(date));
          dayCounter++;
        }
        rows.add(Row(mainAxisAlignment: MainAxisAlignment.center, children: days));
      }
      return rows;
    }

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const SizedBox(height: 12),
        const Text("🔸 이번 달 루틴 체크",
            style: TextStyle(
                color: Colors.white, fontSize: 16, fontFamily: 'Kopub')),
        const SizedBox(height: 12),
        Center(
          child: Text(
            "완료된 날은 자동으로 표시돼요!",
            style: const TextStyle(
                color: Colors.white70,
                fontSize: 12,
                fontFamily: 'Kopub',
                fontWeight: FontWeight.bold),
          ),
        ),
        Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            IconButton(
              icon: const Icon(Icons.chevron_left, color: Colors.white),
              onPressed: () => setState(() => currentMonth =
                  DateTime(currentMonth.year, currentMonth.month - 1)),
            ),
            Text("${currentMonth.year}년 ${currentMonth.month}월",
                style: const TextStyle(
                    color: Colors.white,
                    fontSize: 16,
                    fontFamily: 'kopub',
                    fontWeight: FontWeight.bold)),
            IconButton(
              icon: const Icon(Icons.chevron_right, color: Colors.white),
              onPressed: () => setState(() => currentMonth =
                  DateTime(currentMonth.year, currentMonth.month + 1)),
            ),
          ],
        ),
        const SizedBox(height: 12),
        ...buildCalendarGrid(),
      ],
    );
  }

  /// ✅ 읽어야 할 책
  Widget _buildReadingBookSection(Challenge challenge, List<BookModel> savedBooks) {
    const completeThreshold = 0.97;

    final isSystemDefined = challenge.specificBookMode == SpecificBookMode.systemDefined;
    final isUserDefined = challenge.specificBookMode == SpecificBookMode.userDefined;

    List<BookModel> books = [];

    if (isSystemDefined && detailedRequiredBooks.isNotEmpty) {
      books = detailedRequiredBooks.map((book) {
        final matched = savedBooks.firstWhere((s) => s.id == book.id, orElse: () => book);
        return matched.copyWith(
          pageRead: matched.pageRead ?? 0,
          pageCount: book.pageCount > 0 ? book.pageCount : matched.pageCount,
        );
      }).toList();
    } else if (isUserDefined && challenge.participatingBooks != null) {
      books = challenge.participatingBooks!.map((book) {
        final updated = savedBooks.firstWhere((b) => b.id == book.id, orElse: () => book);
        return updated;
      }).toList();
    }

    if (books.isEmpty) return const SizedBox.shrink();

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text("🔸 읽어야 할 책", style: TextStyle(color: Colors.white, fontSize: 16, fontFamily: 'Kopub')),
        const SizedBox(height: 12),
        ...books.map((book) {
          final pageCount = book.pageCount ?? 0;
          final pageRead = book.pageRead ?? 0;
          final percentage = pageCount > 0
              ? (pageRead / pageCount * 100).clamp(0, 100).toInt()
              : 0;

          final isDone = (book.isCompleted ?? false) ||
              (pageCount > 0 && pageRead >= (pageCount * completeThreshold).floor());

          final progressBar = pageCount > 0
              ? Padding(
            padding: const EdgeInsets.only(top: 6),
            child: LinearProgressIndicator(
              value: (pageRead / pageCount).clamp(0.0, 1.0),
              minHeight: 6,
              backgroundColor: Colors.white24,
              valueColor: AlwaysStoppedAnimation<Color>(
                  isDone ? Colors.greenAccent : Colors.amberAccent),
            ),
          )
              : const SizedBox.shrink();

          return Container(
            margin: const EdgeInsets.only(bottom: 8),
            padding: const EdgeInsets.symmetric(vertical: 10, horizontal: 12),
            decoration: BoxDecoration(
              color: isDone ? Colors.green.withOpacity(0.2) : Colors.white10,
              borderRadius: BorderRadius.circular(8),
            ),
            child: Row(
              children: [
                Icon(
                  isDone ? Icons.check_circle : Icons.radio_button_unchecked,
                  color: isDone ? Colors.greenAccent : Colors.white38,
                ),
                const SizedBox(width: 10),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text("${book.title} (${book.author ?? '작자 미상'})",
                          style: const TextStyle(
                              color: Colors.white, fontFamily: 'kopub', fontSize: 15)),
                      Padding(
                        padding: const EdgeInsets.only(top: 4.0),
                        child: Text(
                          pageCount > 0
                              ? "$pageRead / $pageCount 페이지  ($percentage%)"
                              : "페이지 정보 없음",
                          style: TextStyle(
                              color: isDone ? Colors.greenAccent : Colors.white60,
                              fontSize: 12),
                        ),
                      ),
                      progressBar,
                    ],
                  ),
                ),
              ],
            ),
          );
        }).toList(),
      ],
    );
  }

