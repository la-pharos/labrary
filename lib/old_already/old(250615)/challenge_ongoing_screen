  void onBookSelected(BookModel selectedBook) async {
    final bookId = selectedBook.id;
    final savedBooksProvider = Provider.of<SavedBooksProvider>(context, listen: false);
    final now = widget.challenge.startDate ?? DateTime.now();

    final participatingBooks = widget.challenge.participatingBooks ?? [];

    final alreadyExists = participatingBooks.any((b) => b.id == bookId);
    if (alreadyExists) return;

    BookModel finalBook = selectedBook;

    // ✅ pageCount가 0이면 API 상세 조회
    if ((selectedBook.pageCount ?? 0) == 0 && selectedBook.itemId != null) {
      final fetchedDetail = await BookApiService.fetchBookDetail(selectedBook.itemId!);
      if (fetchedDetail != null) {
        finalBook = fetchedDetail.copyWith(
          category: 'reading',
          startDate: now,
        );
      }
    } else {
      // ✅ 그냥 기본 등록
      finalBook = selectedBook.copyWith(
        category: 'reading',
        startDate: now,
      );
    }

    // ✅ Provider에 저장
    savedBooksProvider.addOrUpdateBook(finalBook);

    // ✅ 참여 도서에 추가
    setState(() {
      participatingBooks.add(finalBook);
      searchResults = [];
      searchController.clear();
    });
  }

  void onBookRemoved(Map<String, String> book) {
    setState(() {
      widget.challenge.participatingBooks?.remove(book);
    });
  }


  @override
  Widget build(BuildContext context) {
    final challengeProvider = Provider.of<ChallengeProvider>(context);
    final savedBooks = Provider.of<SavedBooksProvider>(context).savedBooks;

    // 🔥 최신 상태로 덮어쓰기
    final latestChallenge = challengeProvider.findChallengeById(_currentChallenge.id);
    if (latestChallenge != null && latestChallenge != _currentChallenge) {
      _currentChallenge = latestChallenge;
    }

    // ✅ 이후 모든 코드는 이걸 기준으로 동작
    final challenge = _currentChallenge;

    // ✅ 시간 제한 확인 추가
    final bool isWithinTime = isWithinAllowedTime(challenge);
    final bool showTimeWarning = challenge.allowedStartTime != null && challenge.allowedEndTime != null;

    // ✅ 도전 시작 전 상태 계산
    final now = DateTime.now();
    final today = DateTime(now.year, now.month, now.day);

    final isBeforeStart = (() {
      if (challenge.period == ChallengePeriod.periodBased) {
        final start = challenge.startDate?.toLocal();
        return start != null && today.isBefore(start);
      }
      return false;
    })();

    final isRoutineAndTodayDone = _currentChallenge.type == ChallengeType.routine && isTodaySuccess;

    final ChallengeCheckActionType checkAction = getChallengeCheckActionType(challenge);

    // ✅ progressSource: 타입 안전하게 분기
    // 🧠 1. stageData 준비
    final int stageIndex = recordData['stageIndex'] is int
        ? recordData['stageIndex']
        : int.tryParse(recordData['stageIndex']?.toString() ?? '0') ?? 0;
    final stageKey = 'stage_$stageIndex';
    final stageData = recordData[stageKey] is Map
        ? Map<String, dynamic>.from(recordData[stageKey])
        : <String, dynamic>{};

    // 📌 2. 분기 source
    final progressSource = (checkAction == ChallengeCheckActionType.libraryAuto)
        ? savedBooks
        : stageData;

    // ✅ 로그 출력 (디버깅)
    debugPrint("[DEBUG] recordData: $recordData");
    debugPrint("[DEBUG] isTodaySuccess: $isTodaySuccess");
    debugPrint("[DEBUG] progressSource: $progressSource");

    // ✅ 기록 섹션 분기 (루틴 챌린지만)
    // 📌 3. 기록용 calendar 및 카드에 전달
    final recordSection = (challenge.type == ChallengeType.routine &&
        (checkAction == ChallengeCheckActionType.manual || checkAction == ChallengeCheckActionType.timerAuto))
        ? buildRoutineProgressCalendar(challenge, stageData)
        : null;

    // ✅ remaining 계산
    int remaining = 0;
    if (challenge.period == ChallengePeriod.daysBased &&
        challenge.type == ChallengeType.routine &&
        routineStart != null &&
        routineDays > 0) {
      remaining = routineStart!
          .add(Duration(days: routineDays))
          .difference(today)
          .inDays;
    } else if (challenge.period == ChallengePeriod.daysBased &&
        routineDays > 0) {
      final effectiveStart = challenge.startDate?.toLocal() ?? today;
      remaining = effectiveStart
          .add(Duration(days: routineDays))
          .difference(today)
          .inDays;
    } else if (challenge.period == ChallengePeriod.periodBased && challenge.endDate != null) {
      remaining = challenge.endDate!.toLocal().difference(today).inDays + 1;
    }

    // ✅ remaining 음수 방지
    if (remaining < 0) remaining = 0;

    return GestureDetector(
      onHorizontalDragUpdate: (details) {
        if (details.delta.dx > 20) {
          Navigator.of(context).pushAndRemoveUntil(
            MaterialPageRoute(builder: (_) => const MainScreen(initialTabIndex: 2)),
                (route) => false,
          );
        }
      },
      child: Scaffold(
        backgroundColor: const Color(0xFF013328),
        appBar: AppBar(
          backgroundColor: Colors.transparent,
          elevation: 0,
          leading: IconButton(
            icon: const Icon(Icons.arrow_back, color: Colors.white),
            onPressed: () {
              Navigator.of(context).pushAndRemoveUntil(
                MaterialPageRoute(
                    builder: (_) => const MainScreen(initialTabIndex: 2)),
                (route) => false,
              );
            },
          ),
          centerTitle: true,
          title: Text(
            challenge.title,
            style: const TextStyle(color: Colors.white, fontFamily: 'kopub'),
          ),
          actions: [
            if (challenge.isCustom)
              IconButton(
                icon: const Icon(Icons.edit, color: Colors.white),
