  /// ✅ 진행도 카드 위젯
  Widget _buildProgressCard(Challenge challenge, dynamic source) {
    final now = DateTime.now();
    final today = DateTime(now.year, now.month, now.day);

    final isBeforeStart = challenge.period == ChallengePeriod.periodBased &&
        challenge.startDate != null &&
        today.isBefore(challenge.startDate!.toLocal());

    if (isBeforeStart) {
      final dDay = challenge.startDate!.toLocal().difference(today).inDays;
      return _buildBeforeStartCard(dDay);
    }

    final checkType = getChallengeCheckActionType(challenge);

    // ✅ stageIndex 파싱 (source가 Map일 때만)
    int stageIndex = 0;
    if (source is Map<String, dynamic> && source['stageIndex'] != null) {
      final raw = source['stageIndex'];
      stageIndex = (raw is int) ? raw : int.tryParse(raw.toString()) ?? 0;
    } else if (challenge.attempts.isNotEmpty) {
      // Fallback: ChallengeAttempt에서 가져오기
      final latest = challenge.attempts.last;
      if (latest.stageIndex != null) {
        stageIndex = latest.stageIndex!;
      }
    }

    // ✅ 범위 보정
    stageIndex = challenge.stageDurations.isNotEmpty
        ? stageIndex.clamp(0, challenge.stageDurations.length - 1)
        : 0;

    // ✅ 진행률 계산
    final int targetCount = ChallengeProgressUtils.getTargetCount(challenge, source, stageIndex);
    final int completed = ChallengeProgressUtils.getCompletedCount(challenge, source, stageIndex);
    final double progress = ChallengeProgressUtils.getProgress(challenge, source, stageIndex);
    final int percentage = (progress * 100).toInt();
    final int remainingDays = ChallengeProgressUtils.calculateRemainingDays(challenge, today, source is Map<String, dynamic> ? source : {}, stageIndex);

    final String unit = _getUnitForChallenge(challenge, checkType);

    if (challenge.period == ChallengePeriod.infinite) {
      return _buildProgressContainer(
        "🔄 언제든지 자유롭게 도전할 수 있어요!",
        progress,
        completed,
        targetCount,
        percentage,
        unit,
      );
    }

    if (remainingDays < 0) {
      final dDay = -remainingDays;
      return _buildBeforeStartCard(dDay);
    }

    final statusText = remainingDays == 0
        ? "⏳ 오늘이 마지막 날이에요!"
        : "⏳ 종료까지 D-$remainingDays";

    return _buildProgressContainer(
      statusText,
      progress,
      completed,
      targetCount,
      percentage,
      unit,
    );
  }
  String _getUnitForChallenge(Challenge challenge, ChallengeCheckActionType checkType) {
    if (challenge.method == ChallengeMethod.specificBooks) return "권";
    switch (checkType) {
      case ChallengeCheckActionType.pageAuto:
        return "페이지";
      case ChallengeCheckActionType.timerAuto:
      case ChallengeCheckActionType.manual:
        return "회";
      case ChallengeCheckActionType.libraryAuto:
        return "권";
      case ChallengeCheckActionType.none:
      default:
        return "-";
    }
  }

