    currentMonth = DateTime(today.year, today.month);

    // ✅ 현재 시도 중인 스테이지 인덱스 파악
    stageIndex = _currentChallenge.attempts.isNotEmpty
        ? (_currentChallenge.attempts.last.stageIndex ?? 0)
        : 0;

    // ✅ 참여 도서 목록 초기화
    if (_currentChallenge.method != ChallengeMethod.specificBooks ||
        _currentChallenge.specificBookMode == SpecificBookMode.userDefined) {
      editedBooks = [..._currentChallenge.participatingBooks ?? []];
    }

    // ✅ 기록 로딩
    _recordDataFuture = ChallengeRecordService.fetchChallengeRecord(_currentChallenge.id);
    print("[🐌 LOAD RECORD CALLED] ${DateTime.now()}");
    _loadRecord();

    // ✅ 시스템 정의 책 불러오기
    _loadRequiredBooks();
  }

  Future<void> _loadRecord() async {
    debugPrint("[🚨 _loadRecord 시작됨]");

    final savedBooksProvider = Provider.of<SavedBooksProvider>(context, listen: false);
    final savedBooks = savedBooksProvider.savedBooks;
    final todayKey = "${today.year}-${_twoDigits(today.month)}-${_twoDigits(today.day)}";

    /// 📦 1. 전체 기록 로드
    final data = await ChallengeRecordService.fetchChallengeRecord(_currentChallenge.id);
    recordData = Map<String, dynamic>.from(data ?? {});

    /// ✅ 1-1. stageIndex 파싱
    int stageIndex = 0;
    final rawIndex = recordData['stageIndex'];
    stageIndex = (rawIndex is int) ? rawIndex : int.tryParse(rawIndex?.toString() ?? '0') ?? 0;
    stageIndex = _currentChallenge.stageDurations.isNotEmpty
        ? stageIndex.clamp(0, _currentChallenge.stageDurations.length - 1)
        : 0;
    recordData['stageIndex'] = stageIndex;

    /// ✅ 1-2. 해당 스테이지 전용 데이터 추출
    final checkType = getChallengeCheckActionType(_currentChallenge);
    final stageKey = "stage_$stageIndex";

    final rawStage = recordData[stageKey];
    final stageData = (rawStage is Map)
        ? rawStage.map((key, value) => MapEntry(key.toString(), value))
        : <String, dynamic>{};

    debugPrint("[📦 stageData] $stageData");

    /// ⏱️ 2. 오늘 읽은 시간
    final todayMinutes = await ReadingLogService.getTodayTotalMinutes();
    debugPrint("[DEBUG🔥오늘 총 읽은 시간] todayMinutes: $todayMinutes");

    /// ✅ 3. dailyMinutes 처리 (스테이지별)
    final rawMinutes = stageData['dailyMinutes'];
    dailyMinutesMap = (rawMinutes is Map)
        ? rawMinutes.map((k, v) => MapEntry(k.toString(), int.tryParse(v.toString()) ?? 0))
        : {};
    dailyMinutesMap[todayKey] = todayMinutes;
    stageData['dailyMinutes'] = dailyMinutesMap;

    stageData['stageIndex'] = stageIndex;
    recordData[stageKey] = stageData;
    recordData['stageIndex'] = stageIndex;
    recordData['dailyMinutes'] = dailyMinutesMap;       // UI 계산에 필요
    recordData['routineChecks'] = _routineChecks;       // 수동형 UI 계산에 필요

    /// 📈 4. 진행률 계산
    dynamic progressSource;
    if (checkType == ChallengeCheckActionType.libraryAuto) {
      progressSource = savedBooks;
    } else {
      progressSource = stageData;
    }

    final calculatedProgress = ChallengeProgressUtils.getProgress(_currentChallenge, progressSource, stageIndex);
    final completedCount = ChallengeProgressUtils.getCompletedCount(_currentChallenge, progressSource, stageIndex);
    final targetCount = ChallengeProgressUtils.getTargetCount(_currentChallenge, progressSource, stageIndex);

    /// 🗓️ 5. 시작일 계산
    DateTime effectiveStart;
    final recordStartStr = stageData['routineStartDate']?.toString();
    final recordStartDate = recordStartStr != null ? DateTime.tryParse(recordStartStr)?.toLocal() : null;
    effectiveStart = recordStartDate ?? _currentChallenge.startDate?.toLocal() ?? DateTime.now().toLocal();

    /// 📚 6. 참여 도서 보강
    final List<BookModel> updatedBooks = [];
    for (var book in _currentChallenge.participatingBooks ?? []) {
      BookModel updated = book;

      // 6-1. pageCount 보완
      if ((book.pageCount ?? 0) == 0 && book.itemId != null) {
        final fetched = await BookApiService.fetchBookDetail(book.itemId!);
        if (fetched != null && fetched.pageCount > 0) {
          updated = fetched.copyWith(
            category: book.category,
            startDate: book.startDate,
          );
          savedBooksProvider.addOrUpdateBook(updated);
        }
      }

      /// 6-2. savedBooks 최신화
      final matched = savedBooks.firstWhere((b) => b.id == book.id, orElse: () => updated);
      updated = updated.copyWith(
        pageRead: matched.pageRead,
        pageCount: matched.pageCount,
      );

      updatedBooks.add(updated);
    }

    /// ✅ 7. 상태 반영
    setState(() {
      _currentChallenge = _currentChallenge.copyWith(participatingBooks: updatedBooks);
      routineStart = (_currentChallenge.type == ChallengeType.routine) ? effectiveStart : null;
      routineDays = targetCount;
      remainingDays = ChallengeProgressUtils.calculateRemainingDays(_currentChallenge, today, stageData, stageIndex);
      progress = calculatedProgress;
      completed = completedCount;
      total = targetCount;

      _routineChecks = Map<String, dynamic>.from(stageData['routineChecks'] ?? {});
      isTodaySuccess = (checkType == ChallengeCheckActionType.timerAuto)
          ? todayMinutes >= (_currentChallenge.requiredMinutes ?? 0)
          : (_routineChecks[todayKey] == true);

      // ✅ 스테이지 데이터 저장
      recordData[stageKey] = stageData;
      recordData['stageIndex'] = stageIndex;
    });

    /// 🔁 Firestore에서 책 다시 불러오기
    await savedBooksProvider.reloadFromFirestore();

    /// ✅ 최신 챌린지 데이터 반영
    final latest = Provider.of<ChallengeProvider>(context, listen: false)
        .findChallengeById(_currentChallenge.id);
    if (latest != null) {
      setState(() {
        _currentChallenge = latest.copyWith(participatingBooks: updatedBooks);
      });
    }
  }

  Future<void> _loadRequiredBooks() async {
    if (_currentChallenge.specificBookMode == SpecificBookMode.systemDefined &&
        _currentChallenge.requiredBooks != null) {
      final result = await fetchRequiredBooksFromApi(_currentChallenge.requiredBooks!);

      final savedBooks = Provider.of<SavedBooksProvider>(context, listen: false).savedBooks;

      // ✅ savedBooks의 pageRead, pageCount를 병합
      final withProgress = result.map((book) {
        final matched = savedBooks.firstWhere(
              (b) => b.id == book.id,
          orElse: () => book,
        );
        return book.copyWith(
          pageRead: matched.pageRead,
          pageCount: (book.pageCount ?? 0) > 0 ? book.pageCount : matched.pageCount,
        );
      }).toList();

      setState(() {
        detailedRequiredBooks = withProgress;
      });
    }
  }

